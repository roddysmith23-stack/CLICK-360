# CLICK 360 P2 Cloud local/staging configuration.
# Copy to .env only for a local emulator session. Never use production values.
CLICK360_ENV=emulator
CLICK360_USE_EMULATORS=true
CLICK360_STAGING_PROJECT_ID=demo-click360-p2-staging
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FUNCTIONS_EMULATOR_ORIGIN=http://127.0.0.1:5001/demo-click360-p2-staging/us-central1
CLICK360_P2_ADMIN_ALLOWLIST=qa-owner-a,qa-platform-admin
