rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // CEO Admin Web (r36): the ONE real server-side security boundary for the
    // admin panel. Deliberately a single hardcoded, human-verified email --
    // matches AUTHORIZED_ADMIN_EMAILS in scripts/lib/click360-v16-admin-core.mjs
    // exactly (the same identity that already has unrestricted production
    // database access via Application Default Credentials for the CLI admin
    // scripts). This does not widen the trust boundary; it adds one more
    // access path (the browser) for the same already-fully-trusted operator.
    // Hiding a menu item is NOT security -- every admin-only read/write below
    // is independently gated by this function, checked on every request.
    function isPlatformAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'roddysmithceo@gmail.com';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/approvedUsers/$(request.auth.uid));
    }

    function userData() {
      return userDoc().data;
    }

    function inviteDoc(email) {
      return get(/databases/$(database)/documents/approvedUsersByEmail/$(email));
    }

    function inviteData(email) {
      return inviteDoc(email).data;
    }

    function hasActiveInvite(email) {
      return signedIn()
        && email != null
        && exists(/databases/$(database)/documents/approvedUsersByEmail/$(email))
        && inviteData(email).status == "active"
        && inviteData(email).approved == true;
    }

    function membershipDoc(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }

    function membershipData(businessId) {
      return membershipDoc(businessId).data;
    }

    function supportedMemberRole(role) {
      return role == "worker" || role == "seller" || role == "cashier"
        || role == "inventory" || role == "supervisor" || role == "admin";
    }

    function hasActiveMembership(businessId) {
      let member = membershipData(businessId);
      return signedIn()
        && businessId != "demo-click360"
        && exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid))
        && member.uid == request.auth.uid
        && member.ownerId == businessId
        && member.businessId == businessId
        && member.tenantKey == "owner:" + businessId + ":business:" + businessId
        && member.status == "active"
        && supportedMemberRole(member.role);
    }

    function approvedUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/approvedUsers/$(request.auth.uid))
        && (
          (userData().keys().hasAll(["status", "approved"])
            && userData().status == "active"
            && userData().approved == true)
          || (!userData().keys().hasAll(["status"]) && userData().approved == true)
        )
        && (
          userData().role == "owner"
          || userData().isOwner == true
          || userData().ownerId == request.auth.uid
          || hasActiveMembership(userData().ownerId)
          || (
            request.auth.token.email != null
            && hasActiveInvite(request.auth.token.email)
            && inviteData(request.auth.token.email).ownerId == userData().ownerId
          )
        );
    }

    function legacyOwnerUser() {
      let data = userData();
      return signedIn()
        && exists(/databases/$(database)/documents/approvedUsers/$(request.auth.uid))
        && data.approved == true
        && (!data.keys().hasAny(["status"]) || data.status == "active")
        && data.ownerId == request.auth.uid
        && (data.role == "owner" || data.isOwner == true);
    }

    function accessDoc() {
      return get(/databases/$(database)/documents/accountAccess/$(request.auth.uid));
    }

    function accessData() {
      return accessDoc().data;
    }

    function hasAccountAccess() {
      return signedIn()
        && exists(/databases/$(database)/documents/accountAccess/$(request.auth.uid));
    }

    function accountAccessReadable() {
      let data = accessData();
      return signedIn()
        && hasAccountAccess()
        && data.uid == request.auth.uid
        && data.businessId == request.auth.uid
        && (!data.keys().hasAny(["ownerId"]) || data.ownerId == request.auth.uid)
        && (!data.keys().hasAny(["tenantKey"])
          || data.tenantKey == "owner:" + request.auth.uid + ":business:" + request.auth.uid)
        && data.businessId != "demo-click360"
        && (data.status == "trial" || data.status == "trial_active"
          || data.status == "expired" || data.status == "trial_expired"
          || data.status == "active" || data.status == "paid_base"
          || data.status == "paid_pro" || data.status == "paid_business"
          || data.status == "paid_enterprise" || data.status == "founder"
          || data.status == "founder_legacy" || data.status == "lifetime");
    }

    function activeAccountOwnerUser() {
      let data = accessData();
      return accountAccessReadable()
        && (
          ((data.status == "trial" || data.status == "trial_active")
            && data.trialDays == 7
            && data.trialStartedAt is timestamp
            && request.time < data.trialStartedAt + duration.value(7, "d"))
          || ((data.status == "founder" || data.status == "lifetime")
            && (data.plan == "base" || data.plan == "pro" || data.plan == "founder" || data.plan == "lifetime"))
          // Real commercial tier for historical customers (SHARY, Lia):
          // permanent, no expiresAt check, no billing -- distinct from the
          // internal-only "founder" status above. See v16-domain.js
          // evaluateEntitlement()'s matching founder_legacy branch.
          || (data.status == "founder_legacy" && data.plan == "founder_legacy")
          || (data.status == "active"
            && data.lifetime == true
            && data.plan == "pro"
            && data.planCode == "pro_lifetime"
            && data.billingStatus == "lifetime")
          || ((data.status == "active" || data.status == "paid_base" || data.status == "paid_pro"
              || data.status == "paid_business" || data.status == "paid_enterprise")
            && (data.plan == "normal" || data.plan == "base" || data.plan == "pro"
              || data.plan == "business" || data.plan == "enterprise")
            && (!data.keys().hasAny(["planCode"]) || data.planCode != "pro_lifetime")
            && (!data.keys().hasAny(["expiresAt"])
              || (data.expiresAt is timestamp && request.time < data.expiresAt)))
        );
    }

    function ownerUser() {
      return hasAccountAccess() ? activeAccountOwnerUser() : legacyOwnerUser();
    }

    function ownerReadUser() {
      return hasAccountAccess() ? accountAccessReadable() : legacyOwnerUser();
    }

    function tenantReadable(businessId) {
      // V16.2 keeps the monolithic tenant snapshot owner-only. Worker access
      // returns after business modules move to per-record collections in P1;
      // exposing this document would reveal every module regardless of role.
      return ownerReadUser() && request.auth.uid == businessId;
    }

    function businessUnitDoc(ownerUid, businessId) {
      return get(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId));
    }

    function businessUnitData(ownerUid, businessId) {
      return businessUnitDoc(ownerUid, businessId).data;
    }

    function businessUnitMemberDoc(ownerUid, businessId) {
      return get(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/members/$(request.auth.uid));
    }

    function businessUnitMemberData(ownerUid, businessId) {
      return businessUnitMemberDoc(ownerUid, businessId).data;
    }

    function rootMembershipAfter(ownerUid) {
      return getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/members/$(request.auth.uid)).data;
    }

    function validBusinessUnitIdentity(data, ownerUid, businessId) {
      return ownerUid != "demo-click360"
        && data.ownerUid == ownerUid
        && data.businessId == businessId
        && data.tenantKey == "owner:" + ownerUid + ":business:" + businessId
        && data.boundarySchemaVersion == 1;
    }

    // Phase 3.2 gradual rollout gate: a tenant's Workers module is only
    // reachable while businesses/{ownerUid}/featureFlags/workers exists with
    // { enabled: true }. This doc is provisioned by the trusted migration
    // admin process (worker-boundary-migrate.mjs) and adjusted only by
    // scripts/worker-boundary-admin.mjs (both bypass rules via the Admin
    // SDK); no client can create, update, or delete it. This is the single
    // chokepoint every businessUnits rule below funnels through via
    // businessUnitReady(), so per-tenant activation/deactivation cannot be
    // bypassed from a modified client.
    function workersFeatureFlagEnabled(ownerUid) {
      return exists(/databases/$(database)/documents/businesses/$(ownerUid)/featureFlags/workers)
        && get(/databases/$(database)/documents/businesses/$(ownerUid)/featureFlags/workers).data.enabled == true;
    }

    function businessUnitReady(ownerUid, businessId) {
      let unit = businessUnitData(ownerUid, businessId);
      return signedIn()
        && workersFeatureFlagEnabled(ownerUid)
        && exists(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId))
        && validBusinessUnitIdentity(unit, ownerUid, businessId)
        && unit.status == "CUTOVER_VERIFIED";
    }

    function activeBusinessUnitMember(ownerUid, businessId) {
      let member = businessUnitMemberData(ownerUid, businessId);
      return businessUnitReady(ownerUid, businessId)
        && exists(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/members/$(request.auth.uid))
        && validBusinessUnitIdentity(member, ownerUid, businessId)
        && member.uid == request.auth.uid
        && member.status == "active"
        && supportedMemberRole(member.role)
        && member.permissions is map;
    }

    function businessUnitOwner(ownerUid, businessId) {
      return request.auth.uid == ownerUid
        && ownerUser()
        && businessUnitReady(ownerUid, businessId);
    }

    function businessUnitPermission(ownerUid, businessId, moduleName, action) {
      let member = businessUnitMemberData(ownerUid, businessId);
      return businessUnitOwner(ownerUid, businessId)
        || (activeBusinessUnitMember(ownerUid, businessId)
          && member.permissions.get(moduleName, {}).get(action, false) == true);
    }

    // P0 commercial rule: every business includes at most 2 active workers
    // (excluding the owner) unless additional paid seats are purchased. This
    // is enforced server-side so it cannot be bypassed by a modified client:
    // any write that activates or deactivates a businessUnits member must
    // atomically write the matching entitlement/seats counter in the SAME
    // transaction/batch, or the whole write is rejected.
    function seatEntitlementDoc(ownerUid, businessId) {
      return get(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/entitlement/seats);
    }

    function seatEntitlementData(ownerUid, businessId) {
      return seatEntitlementDoc(ownerUid, businessId).data;
    }

    function seatEntitlementAfter(ownerUid, businessId) {
      return getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/entitlement/seats).data;
    }

    function validSeatEntitlementIdentity(data, ownerUid, businessId) {
      return data.ownerUid == ownerUid
        && data.businessId == businessId
        && data.tenantKey == "owner:" + ownerUid + ":business:" + businessId
        && data.boundarySchemaVersion == 1;
    }

    function seatCapacity(entitlement) {
      return entitlement.baseSeatCap + entitlement.addOnSeats;
    }

    // A seat was validly consumed for request.auth.uid's own activation in
    // this same write: the entitlement counter increases by exactly one,
    // stays within capacity, is tagged with the acting uid, and that same
    // uid's member doc genuinely transitions into "active" in this same
    // transaction (was absent or non-active before, active after). Tying the
    // counter to a real, independently-verified transition means the counter
    // itself can never be bumped by a standalone write.
    function seatConsumedForSelf(ownerUid, businessId) {
      let before = seatEntitlementData(ownerUid, businessId);
      let after = seatEntitlementAfter(ownerUid, businessId);
      let memberPath = /databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/members/$(request.auth.uid);
      let memberAfter = getAfter(memberPath).data;
      return validSeatEntitlementIdentity(after, ownerUid, businessId)
        && after.baseSeatCap == before.baseSeatCap
        && after.addOnSeats == before.addOnSeats
        && after.activeMembers == before.activeMembers + 1
        && after.activeMembers <= seatCapacity(after)
        && after.lastActionUid == request.auth.uid
        && memberAfter.uid == request.auth.uid
        && memberAfter.status == "active"
        && (!exists(memberPath) || get(memberPath).data.status != "active");
    }

    // A seat was validly released by an owner/admin revoking exactly the
    // member named in the entitlement write's own lastActionUid, in this
    // same transaction: the counter decreases by exactly one, and that
    // member's doc genuinely transitions from "active" to "revoked" in this
    // same write. Tying the decrement to a real, named transition means the
    // counter can never be freed by a standalone write without an actual
    // revocation.
    function seatReleased(ownerUid, businessId) {
      let before = seatEntitlementData(ownerUid, businessId);
      let after = seatEntitlementAfter(ownerUid, businessId);
      let releasedUid = after.lastActionUid;
      let memberPath = /databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/members/$(releasedUid);
      return validSeatEntitlementIdentity(after, ownerUid, businessId)
        && after.baseSeatCap == before.baseSeatCap
        && after.addOnSeats == before.addOnSeats
        && after.activeMembers == before.activeMembers - 1
        && after.activeMembers >= 0
        && releasedUid is string && releasedUid.size() > 0
        && get(memberPath).data.status == "active"
        && getAfter(memberPath).data.status == "revoked";
    }

    function validBoundaryCreate(ownerUid, businessId, moduleName, recordId) {
      return validBusinessUnitIdentity(request.resource.data, ownerUid, businessId)
        && request.resource.data.id == recordId
        && request.resource.data.module == moduleName
        && request.resource.data.recordVersion == 1
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validBoundaryUpdate(ownerUid, businessId, moduleName, recordId) {
      return validBusinessUnitIdentity(resource.data, ownerUid, businessId)
        && validBusinessUnitIdentity(request.resource.data, ownerUid, businessId)
        && request.resource.data.id == recordId
        && request.resource.data.id == resource.data.id
        && request.resource.data.module == moduleName
        && request.resource.data.module == resource.data.module
        && request.resource.data.recordVersion == resource.data.recordVersion + 1
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function boundaryProductUpdateAllowed(ownerUid, businessId, recordId) {
      let member = businessUnitMemberData(ownerUid, businessId);
      let productPermissions = member.permissions.get("products", {});
      let salesPermissions = member.permissions.get("sales", {});
      let operationId = request.resource.data.get("lastOperationId", "");
      return businessUnitOwner(ownerUid, businessId)
        || (activeBusinessUnitMember(ownerUid, businessId)
          && (
            productPermissions.get("update", false) == true
            || (productPermissions.get("delete", false) == true
              && request.resource.data.status == "deleted"
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "status", "deletedAt", "recordVersion", "updatedBy", "updatedAt"
              ]))
            || (salesPermissions.get("create", false) == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "stock", "qty", "updatedAtMs", "lastOperationId", "recordVersion", "updatedBy", "updatedAt"
              ])
              && request.resource.data.stock is number
              && request.resource.data.stock >= 0
              && request.resource.data.stock < resource.data.stock
              && operationId.size() > 0
              && getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/sales/$(operationId)).data.actorUid == request.auth.uid
              && getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/sales/$(operationId)).data.createdAt == request.time
              && getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/sales/$(operationId)).data.stockDeltas.get(recordId, 0)
                == resource.data.stock - request.resource.data.stock)
          ));
    }

    function validStatePayload() {
      return request.resource.data.payload.keys().hasAll(["schemaVersion", "identity", "data"])
        && request.resource.data.payload.data.keys().hasAll([
          "businesses", "products", "sales", "movements", "invoices", "dailyReports",
          "deletedProducts", "auditLogs", "settings"
        ])
        && request.resource.data.payload.data.businesses is list
        && request.resource.data.payload.data.businesses.size() > 0
        && request.resource.data.payload.data.products is list
        && request.resource.data.payload.data.sales is list
        && request.resource.data.payload.data.movements is list
        && request.resource.data.payload.data.invoices is list
        && request.resource.data.payload.data.dailyReports is list
        && request.resource.data.payload.data.deletedProducts is list
        && request.resource.data.payload.data.auditLogs is list
        && request.resource.data.payload.data.settings is map
        && request.resource.data.payload.data.settings.keys().hasAll(["workers", "labelTemplates"])
        && request.resource.data.payload.data.settings.workers is list
        && request.resource.data.payload.data.settings.labelTemplates is list
        && (!request.resource.data.payload.data.keys().hasAny(["layaways"]) || request.resource.data.payload.data.layaways is list)
        && (!request.resource.data.payload.data.keys().hasAny(["cashSessions"]) || request.resource.data.payload.data.cashSessions is list)
        && (!request.resource.data.payload.data.keys().hasAny(["notifications"]) || request.resource.data.payload.data.notifications is list)
        && (!request.resource.data.payload.data.keys().hasAny(["legalAcceptances"]) || request.resource.data.payload.data.legalAcceptances is list);
    }

    function writeMatchesTenant(businessId) {
      return businessId != "demo-click360"
        && request.resource.data.schemaVersion == 10
        && request.resource.data.ownerUid == businessId
        && request.resource.data.ownerId == businessId
        && request.resource.data.businessId == businessId
        && request.resource.data.tenantKey == "owner:" + businessId + ":business:" + businessId
        && request.resource.data.payload.schemaVersion == 10
        && request.resource.data.payload.identity.schemaVersion == 10
        && request.resource.data.payload.identity.ownerUid == businessId
        && request.resource.data.payload.identity.ownerId == businessId
        && request.resource.data.payload.identity.businessId == businessId
        && request.resource.data.payload.identity.tenantKey == "owner:" + businessId + ":business:" + businessId
        && validStatePayload();
    }

    function validWorkerUserCreate(uid) {
      return validV16WorkerUserCreate(uid) || (signedIn()
        && uid == request.auth.uid
        && request.auth.token.email != null
        && hasActiveInvite(request.auth.token.email)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == inviteData(request.auth.token.email).role
        && request.resource.data.ownerId == inviteData(request.auth.token.email).ownerId
        && request.resource.data.status == "active"
        && request.resource.data.approved == true
        && request.resource.data.isOwner != true
        && request.resource.data.keys().hasOnly([
          "uid", "email", "role", "ownerId", "name", "photoURL", "status",
          "approved", "businessLimit", "createdAt", "updatedAt", "approvedFromEmail", "isOwner"
        ]));
    }

    function validV16WorkerUserCreate(uid) {
      let ownerId = request.resource.data.ownerId;
      let inviteHash = request.resource.data.invitationHash;
      let invite = get(/databases/$(database)/documents/businesses/$(ownerId)/invitations/$(inviteHash)).data;
      let inviteAfter = getAfter(/databases/$(database)/documents/businesses/$(ownerId)/invitations/$(inviteHash)).data;
      let memberAfter = getAfter(/databases/$(database)/documents/businesses/$(ownerId)/members/$(uid)).data;
      return signedIn()
        && uid == request.auth.uid
        && ownerId != uid
        && ownerId != "demo-click360"
        && request.auth.token.email != null
        && invite.email == request.auth.token.email
        && invite.ownerId == ownerId
        && invite.businessId == ownerId
        && invite.inviteHash == inviteHash
        && invite.status == "pending"
        && invite.createdAt is timestamp
        && request.time < invite.createdAt + duration.value(invite.expiresAfterDays, "d")
        && inviteAfter.status == "accepted"
        && inviteAfter.acceptedBy == uid
        && inviteAfter.consumed == true
        && memberAfter.uid == uid
        && memberAfter.ownerId == ownerId
        && memberAfter.businessId == ownerId
        && (!invite.keys().hasAny(["businessUnitId"])
          || memberAfter.businessUnitId == invite.businessUnitId)
        && memberAfter.invitationHash == inviteHash
        && memberAfter.status == "active"
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.ownerId == ownerId
        && request.resource.data.businessId == ownerId
        && request.resource.data.tenantKey == "owner:" + ownerId + ":business:" + ownerId
        && request.resource.data.invitationHash == inviteHash
        && (!invite.keys().hasAny(["businessUnitId"])
          || request.resource.data.businessUnitId == invite.businessUnitId)
        && request.resource.data.role == invite.role
        && request.resource.data.permissions == invite.permissions
        && request.resource.data.status == "active"
        && request.resource.data.approved == true
        && request.resource.data.isOwner == false
        && request.resource.data.approvedFromInvitation == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "uid", "email", "name", "photoURL", "role", "permissions", "ownerId",
          "businessId", "businessUnitId", "tenantKey", "invitationHash", "status", "approved", "isOwner",
          "businessLimit", "workerLimit", "approvedFromInvitation", "createdAt", "updatedAt"
        ]);
    }

    function validProfileFields() {
      return request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 100000;
    }

    function ownProfileUpdateOnly(uid) {
      return approvedUser()
        && request.auth.uid == uid
        && validProfileFields()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "photoURL", "updatedAt"]);
    }

    function ownerRevokesWorker() {
      return ownerUser()
        && resource.data.ownerId == request.auth.uid
        && resource.data.role != "owner"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "approved", "revokedAt", "revokedBy", "updatedAt"])
        && (request.resource.data.status == "blocked" || request.resource.data.status == "revoked")
        && request.resource.data.approved == false
        && request.resource.data.revokedBy == request.auth.uid;
    }

    function ownerUpdatesWorkerAccess() {
      return ownerUser()
        && resource.data.ownerId == request.auth.uid
        && resource.data.role != "owner"
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.isOwner != true
        && supportedMemberRole(request.resource.data.role)
        && request.resource.data.permissions is map
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role", "permissions", "updatedAt"])
        && request.resource.data.updatedAt == request.time;
    }

    function validInviteWrite(email) {
      return ownerUser()
        && request.resource.data.email == email
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.role == "worker"
        && request.resource.data.status == "active"
        && request.resource.data.approved == true
        && request.resource.data.keys().hasOnly([
          "email", "role", "ownerId", "inviteToken", "status", "approved",
          "name", "businessLimit", "createdAt", "updatedAt"
        ]);
    }

    function validInviteRevoke() {
      return ownerUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "approved", "revokedAt", "revokedBy", "updatedAt"])
        && (request.resource.data.status == "blocked" || request.resource.data.status == "revoked")
        && request.resource.data.approved == false
        && request.resource.data.revokedBy == request.auth.uid;
    }

    match /approvedUsers/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || (ownerUser() && resource.data.ownerId == request.auth.uid && resource.data.role == "worker")
      );
      // Owner accounts are provisioned only by an administrative credential.
      allow create: if validWorkerUserCreate(uid);
      allow update: if ownProfileUpdateOnly(uid) || ownerRevokesWorker() || ownerUpdatesWorkerAccess();
      allow delete: if false;
    }

    match /approvedUsersByEmail/{email} {
      allow read: if signedIn() && (
        request.auth.token.email == email
        || (ownerUser() && resource.data.ownerId == request.auth.uid)
      );
      allow create: if validInviteWrite(email);
      allow update: if validInviteWrite(email) || validInviteRevoke();
      allow delete: if false;
    }

    match /accountAccess/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isPlatformAdmin();
      // CEO Admin Web: activation/plan-change/suspend writes for ANY tenant.
      // The exact field shape (status/planCode/limits/onboardingProfile/etc.)
      // is built by the single canonical activationFields() in
      // v16-domain.js -- the same function the CLI uses -- so this rule only
      // needs to enforce identity/plan-validity/monotonic-revision, not
      // re-derive the whole shape. app.js additionally writes a backup to
      // adminBackups and an entry to adminAuditLogs around every such write.
      allow create: if isPlatformAdmin()
        && uid != "demo-click360"
        && request.resource.data.uid == uid
        && request.resource.data.businessId == uid
        && request.resource.data.plan in ["base", "pro", "business", "enterprise", "founder_legacy"]
        && request.resource.data.revision == 1;
      allow update: if isPlatformAdmin()
        && uid != "demo-click360"
        && request.resource.data.uid == uid
        && request.resource.data.businessId == uid
        && request.resource.data.plan in ["base", "pro", "business", "enterprise", "founder_legacy"]
        && request.resource.data.revision is int
        && request.resource.data.revision > resource.data.revision;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          "uid", "ownerId", "businessId", "tenantKey", "email", "name", "photoURL", "status", "plan", "planCode", "trialDays",
          "trialStartedAt", "lastSeenAt", "createdAt", "source", "entitlementVersion", "revision"
        ])
        && request.resource.data.keys().hasOnly([
          "uid", "ownerId", "businessId", "tenantKey", "email", "name", "photoURL", "status", "plan", "planCode", "trialDays",
          "trialStartedAt", "profileUpdatedAt", "lastSeenAt", "createdAt", "source", "entitlementVersion", "revision"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.businessId == request.auth.uid
        && request.resource.data.tenantKey == "owner:" + request.auth.uid + ":business:" + request.auth.uid
        && request.resource.data.businessId != "demo-click360"
        && request.resource.data.email == request.auth.token.email
        && !exists(/databases/$(database)/documents/approvedUsers/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/approvedUsersByEmail/$(request.auth.token.email))
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && (!request.resource.data.keys().hasAny(["photoURL"])
          || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 100000))
        && request.resource.data.status == "trial"
        && request.resource.data.plan == "normal"
        && request.resource.data.planCode == "base"
        && request.resource.data.trialDays == 7
        && request.resource.data.source == "self_service"
        && request.resource.data.entitlementVersion == 16
        && request.resource.data.revision == 1
        && request.resource.data.trialStartedAt == request.time
        && (!request.resource.data.keys().hasAny(["profileUpdatedAt"])
          || request.resource.data.profileUpdatedAt == request.time)
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "photoURL", "profileUpdatedAt", "lastSeenAt"])
        && request.resource.data.lastSeenAt == request.time
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastSeenAt"])
          || (request.resource.data.profileUpdatedAt == request.time
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 120
            && (!request.resource.data.keys().hasAny(["photoURL"])
              || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 100000)))
        );
      allow delete: if false;
    }

    match /businesses/{businessId}/invitations/{inviteHash} {
      allow read: if businessId != "demo-click360" && signedIn() && (
        (ownerUser() && request.auth.uid == businessId)
        || (request.auth.token.email != null && resource.data.email == request.auth.token.email)
      );
      allow create: if businessId != "demo-click360"
        && ownerUser()
        && request.auth.uid == businessId
        && request.resource.data.keys().hasAll([
          "inviteHash", "email", "name", "role", "permissions", "ownerId", "businessId",
          "tenantKey", "status", "expiresAfterDays", "singleUse", "createdAt", "createdBy", "appVersion"
        ])
        && request.resource.data.keys().hasOnly([
          "inviteHash", "email", "name", "role", "permissions", "ownerId", "businessId", "businessUnitId",
          "tenantKey", "status", "expiresAfterDays", "singleUse", "createdAt", "createdBy", "appVersion"
        ])
        && request.resource.data.inviteHash == inviteHash
        && request.resource.data.ownerId == businessId
        && request.resource.data.businessId == businessId
        && (!request.resource.data.keys().hasAny(["businessUnitId"])
          || (request.resource.data.businessUnitId is string
            && request.resource.data.businessUnitId.size() > 0
            && request.resource.data.businessUnitId.size() <= 120))
        && request.resource.data.tenantKey == "owner:" + businessId + ":business:" + businessId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.name is string
        && supportedMemberRole(request.resource.data.role)
        && request.resource.data.permissions is map
        && request.resource.data.status == "pending"
        && request.resource.data.expiresAfterDays == 7
        && request.resource.data.singleUse == true
        && request.resource.data.createdAt == request.time
        && (request.resource.data.appVersion == "16.0.0" || request.resource.data.appVersion == "16.2.0");
      allow update: if businessId != "demo-click360" && (
        (ownerUser()
          && request.auth.uid == businessId
          && resource.data.ownerId == businessId
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.tenantKey == resource.data.tenantKey
          && request.resource.data.inviteHash == resource.data.inviteHash
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "revokedAt", "revokedBy", "role", "permissions", "updatedAt", "updatedBy"
          ])
          && supportedMemberRole(request.resource.data.role)
          && request.resource.data.permissions is map)
        || (signedIn()
          && request.auth.token.email != null
          && resource.data.email == request.auth.token.email
          && resource.data.status == "pending"
          && resource.data.createdAt is timestamp
          && request.time < resource.data.createdAt + duration.value(resource.data.expiresAfterDays, "d")
          && request.resource.data.status == "accepted"
          && request.resource.data.acceptedBy == request.auth.uid
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.consumed == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "acceptedBy", "acceptedAt", "consumed"])
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data.status == "active")
      );
      allow delete: if false;
    }

    match /businesses/{businessId}/ownerInviteSecrets/{inviteHash} {
      allow read: if businessId != "demo-click360"
        && ownerReadUser()
        && request.auth.uid == businessId;
      allow create, update: if businessId != "demo-click360"
        && ownerUser()
        && request.auth.uid == businessId
        && request.resource.data.ownerId == businessId
        && request.resource.data.inviteHash == inviteHash;
      allow delete: if false;
    }

    match /businesses/{businessId}/members/{uid} {
      allow read: if businessId != "demo-click360" && signedIn() && (
        (ownerReadUser() && request.auth.uid == businessId)
        || request.auth.uid == uid
      );
      allow create: if businessId != "demo-click360" && signedIn() && (
        (ownerUser() && request.auth.uid == businessId
          && request.resource.data.ownerId == businessId
          && request.resource.data.businessId == businessId
          && (!get(/databases/$(database)/documents/businesses/$(businessId)/invitations/$(request.resource.data.invitationHash)).data.keys().hasAny(["businessUnitId"])
            || request.resource.data.businessUnitId == get(/databases/$(database)/documents/businesses/$(businessId)/invitations/$(request.resource.data.invitationHash)).data.businessUnitId)
          && request.resource.data.uid == uid
          && request.resource.data.status == "active"
          && request.resource.data.role != "owner")
        || (request.auth.uid == uid
          && request.auth.token.email != null
          && request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.ownerId == businessId
          && request.resource.data.businessId == businessId
          && request.resource.data.tenantKey == "owner:" + businessId + ":business:" + businessId
          && request.resource.data.status == "active"
          && request.resource.data.role != "owner"
          && request.resource.data.permissions is map
          && get(/databases/$(database)/documents/businesses/$(businessId)/invitations/$(request.resource.data.invitationHash)).data.status == "pending"
          && get(/databases/$(database)/documents/businesses/$(businessId)/invitations/$(request.resource.data.invitationHash)).data.email == request.auth.token.email
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/invitations/$(request.resource.data.invitationHash)).data.status == "accepted"
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.lastAccessAt == request.time)
      );
      allow update: if businessId != "demo-click360"
        && ownerUser()
        && request.auth.uid == businessId
        && resource.data.ownerId == businessId
        && request.resource.data.ownerId == businessId
        && request.resource.data.businessId == businessId
        && request.resource.data.uid == uid
        && request.resource.data.role != "owner"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role", "permissions", "status", "updatedAt", "updatedBy", "revokedAt", "revokedBy"
        ]);
      allow delete: if false;
    }

    // Phase 3.2 per-tenant Workers rollout switch. Admin-provisioned and
    // admin-adjusted only (worker-boundary-migrate.mjs / worker-boundary-admin.mjs
    // via the Admin SDK, which bypasses rules) -- see workersFeatureFlagEnabled().
    // The owner may read their own tenant's flag (e.g. to show rollout status);
    // no client may ever write it.
    match /businesses/{ownerUid}/featureFlags/{docId} {
      allow read: if request.auth.uid == ownerUid || isPlatformAdmin();
      // CEO Admin Web: toggle the Workers flag for a tenant. Production
      // migrations already default this to false on creation (see
      // worker-boundary-migrate.mjs); this only lets the admin flip it once
      // a businessUnit is CUTOVER_VERIFIED, same effect as
      // worker-boundary-admin.mjs --action enable-workers, just from the browser.
      allow update: if isPlatformAdmin()
        && ownerUid != "demo-click360"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["enabled", "enabledAt", "enabledBy", "updatedBy", "updatedAt", "notes"]);
      allow create, delete: if false;
    }

    // Owner-initiated, immutable request log for additional worker seats
    // ("Trabajadores adicionales" screen), while no self-serve purchase
    // flow exists yet. The owner can only create their own request record;
    // fulfillment happens out-of-band via scripts/worker-boundary-admin.mjs
    // (which bypasses rules), not by writing back to this doc from a client.
    match /businesses/{ownerUid}/seatRequests/{requestId} {
      allow read: if request.auth.uid == ownerUid || isPlatformAdmin();
      allow create: if request.auth.uid == ownerUid
        && request.resource.data.ownerUid == ownerUid
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.businessId is string
        && request.resource.data.businessId.size() > 0
        && request.resource.data.requestedAt == request.time
        && request.resource.data.status == "pending";
      allow update, delete: if false;
    }

    // Commercial MVP: owner-initiated request for more products/storage
    // capacity, mirroring seatRequests exactly -- an immutable, auditable
    // record for AIIA, never mutated by the client, no billing automation.
    match /businesses/{ownerUid}/capacityRequests/{requestId} {
      allow read: if request.auth.uid == ownerUid || isPlatformAdmin();
      allow create: if request.auth.uid == ownerUid
        && request.resource.data.ownerUid == ownerUid
        && request.resource.data.requestedBy == request.auth.uid
        && (request.resource.data.kind == "products" || request.resource.data.kind == "storage")
        && request.resource.data.requestedAt == request.time
        && request.resource.data.status == "pending";
      allow update, delete: if false;
    }

    // Phase 3.3 activation evidence trail (worker-boundary-activate-tenant.mjs).
    // Admin-SDK-only, like adminBackups -- written before any mutation and
    // updated once at the end, never by a client.
    match /businesses/{ownerUid}/activationLog/{activationId} {
      allow read: if request.auth.uid == ownerUid || isPlatformAdmin();
      allow create, update, delete: if false;
    }

    // P2 modular boundary. The parent document is an administrative cutover
    // manifest. Public clients cannot create or promote a business unit.
    match /businesses/{ownerUid}/businessUnits/{businessId} {
      allow read: if businessUnitOwner(ownerUid, businessId)
        || activeBusinessUnitMember(ownerUid, businessId)
        || isPlatformAdmin();
      allow create, update, delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/members/{uid} {
      allow read: if businessUnitOwner(ownerUid, businessId)
        || (request.auth.uid == uid && activeBusinessUnitMember(ownerUid, businessId));
      // Seat gate: activation (create, or reactivation via update) must
      // consume exactly one seat in the same write via seatConsumedForSelf,
      // which independently re-checks capacity from the entitlement doc.
      allow create: if businessUnitReady(ownerUid, businessId)
        && request.auth.uid == uid
        && rootMembershipAfter(ownerUid).uid == request.auth.uid
        && rootMembershipAfter(ownerUid).status == "active"
        && supportedMemberRole(rootMembershipAfter(ownerUid).role)
        && validBoundaryCreate(ownerUid, businessId, "members", uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == rootMembershipAfter(ownerUid).role
        && request.resource.data.permissions == rootMembershipAfter(ownerUid).permissions
        && request.resource.data.status == "active"
        && seatConsumedForSelf(ownerUid, businessId);
      allow update: if businessUnitPermission(ownerUid, businessId, "members", "manage")
        && validBoundaryUpdate(ownerUid, businessId, "members", uid)
        && request.resource.data.uid == uid
        && supportedMemberRole(request.resource.data.role)
        && request.resource.data.permissions is map
        && (request.resource.data.status == "active" || request.resource.data.status == "revoked")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role", "permissions", "status", "recordVersion", "updatedBy", "updatedAt", "revokedBy", "revokedAt"
        ])
        && (
          resource.data.status == request.resource.data.status
          || (resource.data.status == "active" && request.resource.data.status == "revoked" && seatReleased(ownerUid, businessId))
          || (resource.data.status == "revoked" && request.resource.data.status == "active" && seatConsumedForSelf(ownerUid, businessId))
        );
      allow delete: if false;
    }

    // Seat entitlement counter for the P0 worker-seat commercial rule.
    // Provisioned only by the trusted migration admin process (bypasses
    // rules); clients may only move it by exactly +/-1 atomically alongside
    // the member write that earns/frees the seat (see seatConsumedForSelf
    // and seatReleased above), or, for the owner, to change the purchased
    // addOnSeats quota (no price is enforced here; that stays a business
    // decision made before calling this write).
    match /businesses/{ownerUid}/businessUnits/{businessId}/entitlement/{docId} {
      allow read: if businessUnitOwner(ownerUid, businessId)
        || activeBusinessUnitMember(ownerUid, businessId);
      allow create: if false;
      allow update: if docId == "seats" && validSeatEntitlementIdentity(request.resource.data, ownerUid, businessId) && (
        (businessUnitOwner(ownerUid, businessId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["addOnSeats", "updatedAt", "updatedBy"])
          && request.resource.data.addOnSeats is int
          && request.resource.data.addOnSeats >= 0
          && request.resource.data.activeMembers == resource.data.activeMembers
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activeMembers", "lastActionUid", "updatedAt", "updatedBy"])
          && request.resource.data.updatedAt == request.time
          && (
            (request.resource.data.updatedBy == request.auth.uid && seatConsumedForSelf(ownerUid, businessId))
            || (businessUnitPermission(ownerUid, businessId, "members", "manage") && seatReleased(ownerUid, businessId))
          ))
      );
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/products/{recordId} {
      allow read: if businessUnitPermission(ownerUid, businessId, "products", "read")
        || businessUnitPermission(ownerUid, businessId, "sales", "read");
      allow create: if businessUnitPermission(ownerUid, businessId, "products", "create")
        && validBoundaryCreate(ownerUid, businessId, "products", recordId)
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0;
      allow update: if validBoundaryUpdate(ownerUid, businessId, "products", recordId)
        && boundaryProductUpdateAllowed(ownerUid, businessId, recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/sales/{recordId} {
      allow read: if businessUnitPermission(ownerUid, businessId, "sales", "read");
      allow create: if businessUnitPermission(ownerUid, businessId, "sales", "create")
        && validBoundaryCreate(ownerUid, businessId, "sales", recordId)
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.items is list
        && request.resource.data.stockDeltas is map
        && request.resource.data.actorUid == request.auth.uid;
      allow update: if businessUnitPermission(ownerUid, businessId, "sales", "update")
        && validBoundaryUpdate(ownerUid, businessId, "sales", recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/layaways/{recordId} {
      allow read: if businessUnitPermission(ownerUid, businessId, "layaways", "read");
      allow create: if businessUnitPermission(ownerUid, businessId, "layaways", "create")
        && validBoundaryCreate(ownerUid, businessId, "layaways", recordId)
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0
        && request.resource.data.actorUid == request.auth.uid;
      allow update: if (
          (businessUnitPermission(ownerUid, businessId, "layaways", "update"))
          || (businessUnitPermission(ownerUid, businessId, "layaways", "payment")
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "payments", "paid", "balance", "status", "recordVersion", "updatedBy", "updatedAt"
            ])
            && resource.data.payments is list
            && request.resource.data.payments is list
            && request.resource.data.payments.size() == resource.data.payments.size() + 1
            && request.resource.data.payments[resource.data.payments.size()].amount is number
            && request.resource.data.payments[resource.data.payments.size()].amount > 0
            && request.resource.data.paid == resource.data.paid + request.resource.data.payments[resource.data.payments.size()].amount
            && request.resource.data.balance == resource.data.balance - request.resource.data.payments[resource.data.payments.size()].amount
            && request.resource.data.balance >= 0)
        ) && validBoundaryUpdate(ownerUid, businessId, "layaways", recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/cashSessions/{recordId} {
      allow read: if businessUnitPermission(ownerUid, businessId, "cashSessions", "read");
      allow create: if businessUnitPermission(ownerUid, businessId, "cashSessions", "create")
        && validBoundaryCreate(ownerUid, businessId, "cashSessions", recordId)
        && request.resource.data.actorUid == request.auth.uid;
      allow update: if (
          businessUnitPermission(ownerUid, businessId, "cashSessions", "update")
          || (businessUnitPermission(ownerUid, businessId, "cashSessions", "close")
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status", "closedAt", "closedBy", "countedCash", "expectedCash", "difference",
              "reportId", "observations", "recordVersion", "updatedBy", "updatedAt"
            ])
            && resource.data.status == "open"
            && request.resource.data.status == "closed"
            && request.resource.data.closedBy == request.auth.uid
            && request.resource.data.countedCash is number
            && request.resource.data.expectedCash is number
            && request.resource.data.difference == request.resource.data.countedCash - request.resource.data.expectedCash)
        ) && validBoundaryUpdate(ownerUid, businessId, "cashSessions", recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/movements/{recordId} {
      allow read: if businessUnitPermission(ownerUid, businessId, "movements", "read");
      allow create: if businessUnitPermission(ownerUid, businessId, "movements", "create")
        && validBoundaryCreate(ownerUid, businessId, "movements", recordId)
        && request.resource.data.amount is number
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/auditEvents/{recordId} {
      allow read: if businessUnitPermission(ownerUid, businessId, "auditEvents", "read");
      allow create: if businessUnitPermission(ownerUid, businessId, "auditEvents", "create")
        && validBoundaryCreate(ownerUid, businessId, "auditEvents", recordId)
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 80;
      allow update, delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/settings/{recordId} {
      allow read: if recordId == "main" && businessUnitPermission(ownerUid, businessId, "settings", "read");
      allow create: if recordId == "main"
        && businessUnitPermission(ownerUid, businessId, "settings", "create")
        && validBoundaryCreate(ownerUid, businessId, "settings", recordId);
      allow update: if recordId == "main"
        && businessUnitPermission(ownerUid, businessId, "settings", "update")
        && validBoundaryUpdate(ownerUid, businessId, "settings", recordId);
      allow delete: if false;
    }

    match /activationRequests/{requestId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          "requestId", "uid", "businessId", "tenantKey", "email", "businessName", "plan",
          "period", "price", "currency", "requestCode", "status", "notes", "createdAt", "appVersion"
        ])
        && request.resource.data.keys().hasOnly([
          "requestId", "uid", "businessId", "tenantKey", "email", "businessName", "plan",
          "period", "price", "currency", "requestCode", "status", "notes", "createdAt", "appVersion"
        ])
        && request.resource.data.requestId == requestId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.businessId == request.auth.uid
        && request.resource.data.tenantKey == "owner:" + request.auth.uid + ":business:" + request.auth.uid
        && (request.resource.data.plan == "base" || request.resource.data.plan == "pro"
          || request.resource.data.plan == "business" || request.resource.data.plan == "enterprise")
        && (request.resource.data.period == "month" || request.resource.data.period == "quarter"
          || request.resource.data.period == "semester" || request.resource.data.period == "year"
          || request.resource.data.period == "custom"
          || (request.resource.data.plan == "base" && request.resource.data.period == "lifetime"))
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.status == "pending"
        && request.resource.data.currency == "USD"
        && (request.resource.data.appVersion == "16.0.0" || request.resource.data.appVersion == "16.2.0")
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /legalAcceptances/{acceptanceId} {
      // r37: CEO Admin must be able to see a customer's real legal status
      // (vigente/pendiente/grace/requiere aceptación) without ever
      // hand-editing Firestore -- isPlatformAdmin() added for that read.
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isPlatformAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          "acceptanceId", "uid", "businessId", "tenantKey", "termsVersion", "privacyVersion",
          "locale", "source", "acceptedAt", "appVersion"
        ])
        && request.resource.data.keys().hasOnly([
          "acceptanceId", "uid", "businessId", "tenantKey", "termsVersion", "privacyVersion",
          "locale", "source", "acceptedAt", "appVersion"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.businessId == request.auth.uid
        && request.resource.data.tenantKey == "owner:" + request.auth.uid + ":business:" + request.auth.uid
        && request.resource.data.acceptanceId == acceptanceId
        && request.resource.data.termsVersion is string
        && request.resource.data.privacyVersion is string
        && (request.resource.data.appVersion == "16.0.0" || request.resource.data.appVersion == "16.2.0")
        && request.resource.data.acceptedAt == request.time;
      allow update, delete: if false;
    }

    // r37 (legacy consent grace): tracks WHEN the "Términos actualizados"
    // banner was first presented to an already-onboarded (legacy) account,
    // separately from legalAcceptances (which only records an actual
    // acceptance). This is mutable bookkeeping -- re-presenting the banner
    // updates lastShownAt but must never move termsPresentedAt backward
    // once set, since that timestamp is what starts the 7-day grace clock.
    // CEO Admin reads this (isPlatformAdmin()) to compute a customer's
    // real legal status (vigente/grace/requiere aceptación) without ever
    // needing to hand-edit Firestore.
    match /legalGraceStatus/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isPlatformAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["uid", "termsPresentedAt", "presentedTermsVersion", "presentedPrivacyVersion", "lastShownAt", "updatedAt"])
        && request.resource.data.uid == uid
        && request.resource.data.termsPresentedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["uid", "termsPresentedAt", "presentedTermsVersion", "presentedPrivacyVersion", "lastShownAt", "updatedAt"])
        && request.resource.data.uid == uid
        // termsPresentedAt is write-once: only the very first presentation
        // may set it (via create); every subsequent update must carry it
        // through unchanged so the 7-day grace window can never be reset.
        && request.resource.data.termsPresentedAt == resource.data.termsPresentedAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // r37 (worker invite flow, Section 11-16): the invite-acceptance
    // transaction already grants a technically-active member record (it
    // must -- server-side seat/security enforcement lives there and is
    // unrelated to this). This collection is a SEPARATE, additive human
    // workflow layer on top: the worker's own client withholds the
    // restricted UI (shows "esperando aprobación" instead) until the
    // OWNER explicitly approves, giving the owner a real chance to review
    // the worker's completed profile before they start operating --
    // without touching the already-audited acceptance transaction/rules.
    match /workerAccessRequests/{requestId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || resource.data.ownerId == request.auth.uid || isPlatformAdmin());
      allow create: if signedIn() && request.auth.uid == request.resource.data.uid
        && requestId == request.resource.data.ownerId + '_' + request.resource.data.uid
        && request.resource.data.keys().hasOnly(["requestId", "ownerId", "uid", "email", "name", "phone", "businessUnitId", "status", "requestedAt", "decidedAt", "decidedBy"])
        && request.resource.data.requestId == requestId
        && request.resource.data.status == "pending"
        && request.resource.data.requestedAt == request.time
        && request.resource.data.decidedAt == null
        && request.resource.data.decidedBy == "";
      allow update: if signedIn() && request.auth.uid == resource.data.ownerId
        && request.resource.data.keys().hasOnly(["requestId", "ownerId", "uid", "email", "name", "phone", "businessUnitId", "status", "requestedAt", "decidedAt", "decidedBy"])
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.requestedAt == resource.data.requestedAt
        && resource.data.status == "pending"
        && (request.resource.data.status == "approved" || request.resource.data.status == "rejected")
        && request.resource.data.decidedAt == request.time
        && request.resource.data.decidedBy == request.auth.uid;
      allow delete: if false;
    }

    // ownerId lets a modular Workers session (where businessId is the
    // business UNIT id, e.g. "biz-p31", not the owner's uid) report
    // telemetry too: tenantKey must be "owner:{ownerId}:business:{businessId}"
    // and the requester must be that tenant's owner or an active unit
    // member. Legacy/owner sessions keep working unchanged: ownerId simply
    // equals businessId there, same as tenantKey's existing self-referential
    // shape.
    function validTelemetryTenant(data) {
      return data.businessId != "demo-click360"
        && data.tenantKey == "owner:" + data.ownerId + ":business:" + data.businessId
        && (
          (data.ownerId == data.businessId && (data.businessId == request.auth.uid || hasActiveMembership(data.businessId)))
          || (data.ownerId != data.businessId && (businessUnitOwner(data.ownerId, data.businessId) || activeBusinessUnitMember(data.ownerId, data.businessId)))
        );
    }

    // Phase 3.2 diagnostic events fire exactly when membership/permission
    // checks fail or a tenant hasn't fully activated -- validTelemetryTenant
    // (which requires proving active membership) would reject the very
    // report of that failure. These event types only require the reporter
    // to be signed in; they carry no write access to tenant data, so a
    // self-reported businessId/tenantKey here is a diagnostics-only signal,
    // not a trust boundary.
    function isTelemetryDiagnosticEvent(eventType) {
      return eventType == "worker_invite_failed" || eventType == "worker_login_failed"
        || eventType == "worker_permission_denied" || eventType == "worker_stock_error"
        || eventType == "worker_cross_tenant_denied" || eventType == "worker_seat_exhausted";
    }

    match /telemetryEvents/{eventId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          "eventId", "eventType", "uidHash", "ownerId", "businessId", "tenantKey", "appVersion",
          "requestId", "mode", "errorCode", "deviceIdHash", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "eventId", "eventType", "uidHash", "ownerId", "businessId", "tenantKey", "appVersion",
          "requestId", "mode", "errorCode", "deviceIdHash", "createdAt"
        ])
        && request.resource.data.eventId == eventId
        && request.resource.data.ownerId is string
        && (isTelemetryDiagnosticEvent(request.resource.data.eventType) || validTelemetryTenant(request.resource.data))
        && (request.resource.data.eventType == "login" || request.resource.data.eventType == "bootstrap"
          || request.resource.data.eventType == "cache_failure" || request.resource.data.eventType == "online_only"
          || request.resource.data.eventType == "sync" || request.resource.data.eventType == "plan_request"
          || request.resource.data.eventType == "invitation" || request.resource.data.eventType == "cash_open"
          || request.resource.data.eventType == "cash_close" || request.resource.data.eventType == "template_save_failure"
          || isTelemetryDiagnosticEvent(request.resource.data.eventType)
          || request.resource.data.eventType == "seat_request")
        && request.resource.data.uidHash is string
        && request.resource.data.uidHash.size() == 16
        && request.resource.data.deviceIdHash is string
        && request.resource.data.deviceIdHash.size() == 16
        && request.resource.data.requestId is string
        && request.resource.data.requestId.size() <= 64
        && request.resource.data.mode is string
        && request.resource.data.mode.size() <= 40
        && request.resource.data.errorCode is string
        && request.resource.data.errorCode.size() <= 80
        && (request.resource.data.appVersion == "16.0.0" || request.resource.data.appVersion == "16.2.0")
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /businesses/{businessId}/auditEvents/{eventId} {
      allow read: if businessId != "demo-click360"
        && ownerReadUser()
        && request.auth.uid == businessId;
      allow create: if businessId != "demo-click360"
        && signedIn()
        && (request.auth.uid == businessId || hasActiveMembership(businessId))
        && request.resource.data.keys().hasAll([
          "eventId", "businessId", "tenantKey", "actorUid", "actorRole", "actorName",
          "action", "entityType", "entityId", "correlationId", "amount", "status",
          "before", "after", "appVersion", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "eventId", "businessId", "tenantKey", "actorUid", "actorRole", "actorName",
          "action", "entityType", "entityId", "correlationId", "amount", "status",
          "before", "after", "appVersion", "createdAt"
        ])
        && request.resource.data.eventId == eventId
        && request.resource.data.businessId == businessId
        && request.resource.data.tenantKey == "owner:" + businessId + ":business:" + businessId
        && request.resource.data.actorUid == request.auth.uid
        && (request.resource.data.actorRole == "owner" || request.resource.data.actorRole == "worker"
          || request.resource.data.actorRole == "cashier" || request.resource.data.actorRole == "inventory")
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() <= 120
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 80
        && request.resource.data.entityType is string
        && request.resource.data.entityType.size() <= 40
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() <= 100
        && request.resource.data.correlationId is string
        && request.resource.data.correlationId.size() > 0
        && request.resource.data.correlationId.size() <= 100
        && request.resource.data.amount is number
        && request.resource.data.status is string
        && request.resource.data.status.size() <= 40
        && request.resource.data.before is map
        && request.resource.data.before.keys().hasOnly(["status", "amount", "stock", "role"])
        && request.resource.data.after is map
        && request.resource.data.after.keys().hasOnly(["status", "amount", "stock", "role"])
        && (request.resource.data.appVersion == "16.0.0" || request.resource.data.appVersion == "16.2.0")
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Administrative operations mostly run through IAM-protected Admin SDK
    // tooling (which bypasses rules entirely) -- these two collections stay
    // hard-blocked for every ordinary client. The ONE exception is the CEO
    // Admin Web panel (r36): the platform admin can create (never modify or
    // delete) a backup/audit entry, and read the audit trail back, exactly
    // mirroring the backup-before-write / audit-after-write pattern every
    // CLI admin script already follows.
    match /adminBackups/{backupId} {
      allow read: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && request.resource.data.actorEmail is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /adminAuditLogs/{eventId} {
      allow read: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && request.resource.data.actorEmail is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // The public client may only read/write the tenant state document. Legacy
    // backups are created by the administrative migrator with Admin SDK.
    match /businesses/{businessId}/state/{stateId} {
      allow read: if stateId == "main" && tenantReadable(businessId);
      allow read: if stateId == "main" && isPlatformAdmin();
      allow create: if stateId == "main" && request.auth.uid == businessId && ownerUser() && writeMatchesTenant(businessId);
      allow update: if stateId == "main"
        && ownerUser()
        && request.auth.uid == businessId
        && writeMatchesTenant(businessId);
      allow delete: if false;
    }

    match /businesses/{businessId}/legacyBackups/{backupId} {
      allow read, write: if false;
    }
  }
}
