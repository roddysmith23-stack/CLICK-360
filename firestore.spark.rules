rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // CEO Admin Web (r36): the ONE real server-side security boundary for the
    // admin panel. Deliberately a single hardcoded, human-verified email --
    // matches AUTHORIZED_ADMIN_EMAILS in scripts/lib/click360-v16-admin-core.mjs
    // exactly (the same identity that already has unrestricted production
    // database access via Application Default Credentials for the CLI admin
    // scripts). This does not widen the trust boundary; it adds one more
    // access path (the browser) for the same already-fully-trusted operator.
    // Hiding a menu item is NOT security -- every admin-only read/write below
    // is independently gated by this function, checked on every request.
    function isPlatformAdmin() {
      return signedIn()
        && request.auth.token.get("email", null) != null
        && request.auth.token.email.lower() == 'roddysmithceo@gmail.com';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/approvedUsers/$(request.auth.uid));
    }

    function userData() {
      return userDoc().data;
    }

    function inviteDoc(email) {
      return get(/databases/$(database)/documents/approvedUsersByEmail/$(email));
    }

    function inviteData(email) {
      return inviteDoc(email).data;
    }

    function hasActiveInvite(email) {
      return signedIn()
        && email != null
        && exists(/databases/$(database)/documents/approvedUsersByEmail/$(email))
        && inviteData(email).status == "active"
        && inviteData(email).approved == true;
    }

    function membershipDoc(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }

    function membershipData(businessId) {
      return membershipDoc(businessId).data;
    }

    function supportedMemberRole(role) {
      return role in ["worker", "seller", "cashier", "inventory", "supervisor", "admin"];
    }

    function hasActiveMembership(businessId) {
      let member = membershipData(businessId);
      return signedIn()
        && businessId != "demo-click360"
        && exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid))
        && member.uid == request.auth.uid
        && member.ownerId == businessId
        && member.businessId == businessId
        && member.tenantKey == "owner:" + businessId + ":business:" + businessId
        && member.status == "active"
        && supportedMemberRole(member.role);
    }

    function approvedUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/approvedUsers/$(request.auth.uid))
        && (
          (userData().keys().hasAll(["status", "approved"])
            && userData().status == "active"
            && userData().approved == true)
          || (!userData().keys().hasAll(["status"]) && userData().approved == true)
        )
        && (
          userData().role == "owner"
          || userData().isOwner == true
          || userData().ownerId == request.auth.uid
          || hasActiveMembership(userData().ownerId)
          || (
            request.auth.token.email != null
            && hasActiveInvite(request.auth.token.email)
            && inviteData(request.auth.token.email).ownerId == userData().ownerId
          )
        );
    }

    function legacyOwnerUser() {
      let data = userData();
      return signedIn()
        && exists(/databases/$(database)/documents/approvedUsers/$(request.auth.uid))
        && data.approved == true
        && (!data.keys().hasAny(["status"]) || data.status == "active")
        && data.ownerId == request.auth.uid
        && (data.role == "owner" || data.isOwner == true);
    }

    function accessDoc() {
      return get(/databases/$(database)/documents/accountAccess/$(request.auth.uid));
    }

    function accessData() {
      return accessDoc().data;
    }

    function hasAccountAccess() {
      return signedIn()
        && exists(/databases/$(database)/documents/accountAccess/$(request.auth.uid));
    }

    function accountAccessReadable() {
      let data = accessData();
      return signedIn()
        && hasAccountAccess()
        && data.uid == request.auth.uid
        && data.businessId == request.auth.uid
        && (!data.keys().hasAny(["ownerId"]) || data.ownerId == request.auth.uid)
        && (!data.keys().hasAny(["tenantKey"])
          || data.tenantKey == "owner:" + request.auth.uid + ":business:" + request.auth.uid)
        && data.businessId != "demo-click360"
        && data.status in ["trial", "trial_active", "expired", "trial_expired", "active", "paid_base",
          "paid_pro", "paid_business", "paid_enterprise", "founder", "founder_legacy", "lifetime"];
    }

    function activeAccountOwnerUser() {
      let data = accessData();
      return accountAccessReadable()
        && (
          ((data.status in ["trial", "trial_active"])
            && data.trialDays == 7
            && data.trialStartedAt is timestamp
            && request.time < data.trialStartedAt + duration.value(7, "d"))
          || ((data.status in ["founder", "lifetime"])
            && data.plan in ["base", "pro", "founder", "lifetime"])
          // Real commercial tier for historical customers (SHARY, Lia):
          // permanent, no expiresAt check, no billing -- distinct from the
          // internal-only "founder" status above. See v16-domain.js
          // evaluateEntitlement()'s matching founder_legacy branch.
          || (data.status == "founder_legacy" && data.plan == "founder_legacy")
          || (data.status == "active"
            && data.lifetime == true
            && data.plan == "pro"
            && data.planCode == "pro_lifetime"
            && data.billingStatus == "lifetime")
          || ((data.status in ["active", "paid_base", "paid_pro", "paid_business", "paid_enterprise"])
            && data.plan in ["normal", "base", "pro", "business", "enterprise"]
            && (!data.keys().hasAny(["planCode"]) || data.planCode != "pro_lifetime")
            && (!data.keys().hasAny(["expiresAt"])
              || (data.expiresAt is timestamp && request.time < data.expiresAt)))
        );
    }

    function ownerUser() {
      return hasAccountAccess() ? activeAccountOwnerUser() : legacyOwnerUser();
    }

    function ownerReadUser() {
      return hasAccountAccess() ? accountAccessReadable() : legacyOwnerUser();
    }

    function tenantReadable(businessId) {
      // V16.2 keeps the monolithic tenant snapshot owner-only. Worker access
      // returns after business modules move to per-record collections in P1;
      // exposing this document would reveal every module regardless of role.
      return ownerReadUser() && request.auth.uid == businessId;
    }

    function businessUnitDoc(ownerUid, businessId) {
      return get(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId));
    }

    function businessUnitData(ownerUid, businessId) {
      return businessUnitDoc(ownerUid, businessId).data;
    }

    function businessUnitMemberDoc(ownerUid, businessId) {
      return get(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/members/$(request.auth.uid));
    }

    function businessUnitMemberData(ownerUid, businessId) {
      return businessUnitMemberDoc(ownerUid, businessId).data;
    }

    function rootMembershipAfter(ownerUid) {
      return getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/members/$(request.auth.uid)).data;
    }

    function validBusinessUnitIdentity(data, ownerUid, businessId) {
      return ownerUid != "demo-click360"
        && data.ownerUid == ownerUid
        && data.businessId == businessId
        && data.tenantKey == "owner:" + ownerUid + ":business:" + businessId
        && data.boundarySchemaVersion == 1;
    }

    // Phase 3.2 gradual rollout gate: a tenant's Workers module is only
    // reachable while businesses/{ownerUid}/featureFlags/workers exists with
    // { enabled: true }. This doc is provisioned by the trusted migration
    // admin process (worker-boundary-migrate.mjs) and adjusted only by
    // scripts/worker-boundary-admin.mjs (both bypass rules via the Admin
    // SDK); no client can create, update, or delete it. This is the single
    // chokepoint every businessUnits rule below funnels through via
    // businessUnitReady(), so per-tenant activation/deactivation cannot be
    // bypassed from a modified client.
    function workersFeatureFlagEnabled(ownerUid) {
      return exists(/databases/$(database)/documents/businesses/$(ownerUid)/featureFlags/workers)
        && get(/databases/$(database)/documents/businesses/$(ownerUid)/featureFlags/workers).data.enabled == true;
    }

    function businessUnitReady(ownerUid, businessId) {
      let unit = businessUnitData(ownerUid, businessId);
      return signedIn()
        && workersFeatureFlagEnabled(ownerUid)
        && exists(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId))
        && validBusinessUnitIdentity(unit, ownerUid, businessId)
        && unit.status == "CUTOVER_VERIFIED";
    }

    function activeBusinessUnitMember(ownerUid, businessId) {
      let member = businessUnitMemberData(ownerUid, businessId);
      return businessUnitReady(ownerUid, businessId)
        && exists(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/members/$(request.auth.uid))
        && validBusinessUnitIdentity(member, ownerUid, businessId)
        && member.uid == request.auth.uid
        && member.status == "active"
        && supportedMemberRole(member.role)
        && member.permissions is map;
    }

    function businessUnitOwner(ownerUid, businessId) {
      return request.auth.uid == ownerUid
        && ownerUser()
        && businessUnitReady(ownerUid, businessId);
    }

    function businessUnitPermission(ownerUid, businessId, moduleName, action) {
      let member = businessUnitMemberData(ownerUid, businessId);
      return businessUnitOwner(ownerUid, businessId)
        || (signedIn() && request.auth.uid != ownerUid && activeBusinessUnitMember(ownerUid, businessId)
          && member.permissions.get(moduleName, {}).get(action, false) == true);
    }

    // r37.2 (LOGISTICS WORKER PERMISSIONS): the real backend half of "un
    // Vendedor A solo puede tocar la Ruta A" -- reads the actual route
    // document and checks the requester's uid against its real assignment
    // fields. Mirrors p2-logistics-domain.js's canAccessRoute() at the
    // rules layer so a hand-crafted request (bypassing the app entirely)
    // is rejected the same way a client-side check would be, not just
    // hidden from the UI.
    function logisticsRouteData(ownerUid, businessId, routeId) {
      return get(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/logisticsRoutes/$(routeId)).data;
    }

    function logisticsAssignedTo(ownerUid, businessId, routeId, field) {
      return logisticsRouteData(ownerUid, businessId, routeId).get(field, "") == request.auth.uid;
    }

    // P0 commercial rule: every business includes at most 2 active workers
    // (excluding the owner) unless additional paid seats are purchased. This
    // is enforced server-side so it cannot be bypassed by a modified client:
    // any write that activates or deactivates a businessUnits member must
    // atomically write the matching entitlement/seats counter in the SAME
    // transaction/batch, or the whole write is rejected.
    function seatEntitlementDoc(ownerUid, businessId) {
      return get(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/entitlement/seats);
    }

    function seatEntitlementData(ownerUid, businessId) {
      return seatEntitlementDoc(ownerUid, businessId).data;
    }

    function seatEntitlementAfter(ownerUid, businessId) {
      return getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/entitlement/seats).data;
    }

    function validSeatEntitlementIdentity(data, ownerUid, businessId) {
      return data.ownerUid == ownerUid
        && data.businessId == businessId
        && data.tenantKey == "owner:" + ownerUid + ":business:" + businessId
        && data.boundarySchemaVersion == 1;
    }

    function seatCapacity(entitlement) {
      return entitlement.baseSeatCap + entitlement.addOnSeats;
    }

    // A seat was validly consumed for request.auth.uid's own activation in
    // this same write: the entitlement counter increases by exactly one,
    // stays within capacity, is tagged with the acting uid, and that same
    // uid's member doc genuinely transitions into "active" in this same
    // transaction (was absent or non-active before, active after). Tying the
    // counter to a real, independently-verified transition means the counter
    // itself can never be bumped by a standalone write.
    function seatConsumedForSelf(ownerUid, businessId) {
      let before = seatEntitlementData(ownerUid, businessId);
      let after = seatEntitlementAfter(ownerUid, businessId);
      let memberPath = /databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/members/$(request.auth.uid);
      let memberAfter = getAfter(memberPath).data;
      return validSeatEntitlementIdentity(after, ownerUid, businessId)
        && after.baseSeatCap == before.baseSeatCap
        && after.addOnSeats == before.addOnSeats
        && after.activeMembers == before.activeMembers + 1
        && after.activeMembers <= seatCapacity(after)
        && after.lastActionUid == request.auth.uid
        && memberAfter.uid == request.auth.uid
        && memberAfter.status == "active"
        && (!exists(memberPath) || get(memberPath).data.status != "active");
    }

    // A seat was validly released by an owner/admin revoking exactly the
    // member named in the entitlement write's own lastActionUid, in this
    // same transaction: the counter decreases by exactly one, and that
    // member's doc genuinely transitions from "active" to "revoked" in this
    // same write. Tying the decrement to a real, named transition means the
    // counter can never be freed by a standalone write without an actual
    // revocation.
    function seatReleased(ownerUid, businessId) {
      let before = seatEntitlementData(ownerUid, businessId);
      let after = seatEntitlementAfter(ownerUid, businessId);
      let releasedUid = after.lastActionUid;
      let memberPath = /databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/members/$(releasedUid);
      return validSeatEntitlementIdentity(after, ownerUid, businessId)
        && after.baseSeatCap == before.baseSeatCap
        && after.addOnSeats == before.addOnSeats
        && after.activeMembers == before.activeMembers - 1
        && after.activeMembers >= 0
        && releasedUid is string && releasedUid.size() > 0
        && get(memberPath).data.status == "active"
        && getAfter(memberPath).data.status == "revoked";
    }

    function validBoundaryCreate(ownerUid, businessId, moduleName, recordId) {
      return validBusinessUnitIdentity(request.resource.data, ownerUid, businessId)
        && sparkLegacyWritable(ownerUid)
        && request.resource.data.id == recordId
        && request.resource.data.module == moduleName
        && request.resource.data.recordVersion == 1
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validBoundaryUpdate(ownerUid, businessId, moduleName, recordId) {
      return validBusinessUnitIdentity(resource.data, ownerUid, businessId)
        && sparkLegacyWritable(ownerUid)
        && validBusinessUnitIdentity(request.resource.data, ownerUid, businessId)
        && request.resource.data.id == recordId
        && request.resource.data.id == resource.data.id
        && request.resource.data.module == moduleName
        && request.resource.data.module == resource.data.module
        && request.resource.data.recordVersion == resource.data.recordVersion + 1
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function boundaryProductUpdateAllowed(ownerUid, businessId, recordId) {
      let member = businessUnitMemberData(ownerUid, businessId);
      let productPermissions = member.permissions.get("products", {});
      let salesPermissions = member.permissions.get("sales", {});
      let operationId = request.resource.data.get("lastOperationId", "");
      return businessUnitOwner(ownerUid, businessId)
        || (signedIn() && request.auth.uid != ownerUid && activeBusinessUnitMember(ownerUid, businessId)
          && (
            productPermissions.get("update", false) == true
            || (productPermissions.get("delete", false) == true
              && request.resource.data.status == "deleted"
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "status", "deletedAt", "recordVersion", "updatedBy", "updatedAt"
              ]))
            || (salesPermissions.get("create", false) == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "stock", "qty", "updatedAtMs", "lastOperationId", "recordVersion", "updatedBy", "updatedAt"
              ])
              && request.resource.data.stock is number
              && request.resource.data.stock >= 0
              && request.resource.data.stock < resource.data.stock
              && operationId.size() > 0
              && getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/sales/$(operationId)).data.actorUid == request.auth.uid
              && getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/sales/$(operationId)).data.createdAt == request.time
              && getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/sales/$(operationId)).data.stockDeltas.get(recordId, 0)
                == resource.data.stock - request.resource.data.stock)
          ));
    }

    // Spark V1 control is owner-wide because legacy state/main contains ALL
    // businesses. A business-only client fence cannot protect this document.
    function sparkControlPath(ownerUid) {
      return /databases/$(database)/documents/businesses/$(ownerUid)/metadata/storage;
    }

    function sparkLegacyWritable(ownerUid) {
      return !existsAfter(sparkControlPath(ownerUid))
        || getAfter(sparkControlPath(ownerUid)).data.storageMode == "legacy";
    }

    function sparkLegacyReadable(ownerUid) {
      return !exists(sparkControlPath(ownerUid)) || get(sparkControlPath(ownerUid)).data.storageMode == "legacy";
    }

    function sparkOwner(ownerUid) {
      return signedIn() && request.auth.uid == ownerUid
        && (exists(/databases/$(database)/documents/accountAccess/$(ownerUid))
          ? sparkAccountWritable(ownerUid) : sparkApprovedOwnerReadable(ownerUid));
    }

    function sparkOwnerRead(ownerUid) {
      return signedIn() && request.auth.uid == ownerUid && sparkOwnerReadableAccess(ownerUid);
    }

    function sparkOwnerReadableAccess(ownerUid) {
      // Same readable contract as ownerReadUser, evaluated against the path
      // owner once. Do not re-enter the legacy signedIn/exists/get call chain
      // for every server read included in a composed transaction.
      return exists(/databases/$(database)/documents/accountAccess/$(ownerUid))
        ? sparkAccountReadable(ownerUid) : sparkApprovedOwnerReadable(ownerUid);
    }

    function sparkAccountReadable(ownerUid) {
      let d = get(/databases/$(database)/documents/accountAccess/$(ownerUid)).data;
      return sparkAccountReadableData(d, ownerUid);
    }

    function sparkAccountReadableData(d, ownerUid) {
      return d.uid == ownerUid && d.businessId == ownerUid
        && d.get("ownerId", ownerUid) == ownerUid
        && d.get("tenantKey", "owner:" + ownerUid + ":business:" + ownerUid) == "owner:" + ownerUid + ":business:" + ownerUid
        && ownerUid != "demo-click360"
        && d.status in ["trial", "trial_active", "expired", "trial_expired", "active", "paid_base",
          "paid_pro", "paid_business", "paid_enterprise", "founder", "founder_legacy", "lifetime"];
    }

    function sparkAccountWritable(ownerUid) {
      let d = get(/databases/$(database)/documents/accountAccess/$(ownerUid)).data;
      return sparkAccountReadableData(d, ownerUid)
        && (d.status in ["trial", "trial_active"]
          ? (d.trialDays == 7 && d.trialStartedAt is timestamp
            && request.time < d.trialStartedAt + duration.value(7, "d"))
          : (d.status in ["founder", "lifetime"]
            ? d.plan in ["base", "pro", "founder", "lifetime"]
            : (d.status == "founder_legacy" ? d.plan == "founder_legacy"
              : ((d.status == "active" && d.get("lifetime", false) == true && d.plan == "pro"
                  && d.get("planCode", "") == "pro_lifetime" && d.get("billingStatus", "") == "lifetime")
                || (d.status in ["active", "paid_base", "paid_pro", "paid_business", "paid_enterprise"]
                  && d.plan in ["normal", "base", "pro", "business", "enterprise"]
                  && d.get("planCode", "") != "pro_lifetime"
                  && (!d.keys().hasAny(["expiresAt"]) || (d.expiresAt is timestamp && request.time < d.expiresAt)))))));
    }

    function sparkApprovedOwnerReadable(ownerUid) {
      let d = get(/databases/$(database)/documents/approvedUsers/$(ownerUid)).data;
      return d.approved == true && d.get("status", "active") == "active"
        && d.ownerId == ownerUid && (d.role == "owner" || d.isOwner == true);
    }

    function sparkRolloutAllowed(ownerUid) {
      let policy = get(/databases/$(database)/documents/storageRollout/sparkV1).data;
      return policy.enabled == true && ownerUid in policy.pilotOwnerUids;
    }

    function sparkPhaseStep(before, after) {
      return before == after
        || (before == "LEGACY" && after == "MIGRATION_PREPARING")
        || (before == "MIGRATION_PREPARING" && after == "SHADOW_WRITING")
        || (before == "SHADOW_WRITING" && after == "SHADOW_VERIFYING")
        || (before == "SHADOW_VERIFYING" && after == "READY_TO_CUTOVER")
        || (before == "READY_TO_CUTOVER" && after == "MODULAR")
        || (before == "MODULAR" && after == "FROZEN");
    }

    function sparkModeMatchesPhase(data) {
      return (data.phase == "LEGACY" && data.storageMode == "legacy")
        || (data.phase in ["MIGRATION_PREPARING", "SHADOW_WRITING", "SHADOW_VERIFYING", "READY_TO_CUTOVER"]
          && data.storageMode == "migrating")
        || (data.phase == "MODULAR" && data.storageMode == "modular"
          && data.semanticEquality == "PASS" && data.reconstructedHash == data.sourceHash)
        || (data.phase == "FROZEN" && data.storageMode == "frozen");
    }

    function sparkValidControl(ownerUid) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "ownerUid", "schemaVersion", "storageMode", "phase", "sourceHash", "remoteHash",
          "remoteRevision", "deviceRevision", "sourceDeviceId", "businessIds", "recordCount",
          "payloadBytes", "recordVersion", "semanticEquality", "reconstructedHash", "buildSha",
          "createdAt", "updatedAt", "updatedBy"
        ])
        && data.ownerUid == ownerUid && data.schemaVersion == 2
        && data.sourceHash is string && data.sourceHash.size() == 64
        && data.remoteHash is string && data.remoteHash.size() == 64
        && data.remoteRevision is int && data.remoteRevision >= 0
        && data.deviceRevision is string && data.sourceDeviceId is string
        && data.sourceDeviceId.size() > 0 && data.sourceDeviceId.size() <= 120
        && data.businessIds is list && data.businessIds.size() > 0
        && data.businessIds.toSet().size() == data.businessIds.size()
        && data.recordCount is int && data.recordCount > 0
        && data.payloadBytes is int && data.payloadBytes > 0
        && data.buildSha is string && data.buildSha.size() >= 12 && data.buildSha.size() <= 40
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time
        && sparkModeMatchesPhase(data);
    }

    function sparkShadowOwner(ownerUid, businessId) {
      let control = get(sparkControlPath(ownerUid)).data;
      return control.storageMode == "migrating" && control.phase == "SHADOW_WRITING"
        && businessId in control.businessIds && sparkOwner(ownerUid);
    }

    function sparkModuleReadable(ownerUid, businessId, moduleName, recordId) {
      let control = get(sparkControlPath(ownerUid)).data;
      return signedIn() && control.storageMode in ["migrating", "modular", "frozen"]
        && businessId in control.businessIds
        && (request.auth.uid == ownerUid ? sparkOwnerReadableAccess(ownerUid) : (isPlatformAdmin()
          || (control.storageMode == "modular"
            && sparkWorkerRecordRead(ownerUid, businessId, moduleName, recordId))));
    }

    function sparkWorkerRecordRead(ownerUid, businessId, moduleName, recordId) {
      return (moduleName in ["products", "sales", "layaways", "cashSessions", "dailyReports", "movements", "metadata", "customers", "config"]
          && sparkPermission(ownerUid, businessId,
            moduleName in ["cashSessions", "dailyReports", "metadata"] ? "cashSessions" : (moduleName == "config" ? "settings" : moduleName), "read"))
        || (moduleName in ["operationLedger", "auditEvents"] && sparkActiveMember(ownerUid, businessId)
          && ((request.method == "get" && !exists(request.path)) || resource.data.createdBy == request.auth.uid))
        // A sale-authorized actor must be able to confirm their own atomic
        // receipt without gaining general visibility over cash movements.
        || (moduleName == "movements" && sparkActiveMember(ownerUid, businessId)
          && ((request.method == "get" && !exists(request.path))
            || (resource.data.createdBy == request.auth.uid && resource.data.data.operationId == recordId
              && get(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/operationLedger/$(recordId)).data.createdBy == request.auth.uid
              && get(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/operationLedger/$(recordId)).data.data.status == "committed")));
    }

    function sparkActiveMember(ownerUid, businessId) {
      let member = businessUnitMemberData(ownerUid, businessId);
      return signedIn() && workersFeatureFlagEnabled(ownerUid)
        && exists(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/members/$(request.auth.uid))
        && validBusinessUnitIdentity(member, ownerUid, businessId)
        && member.uid == request.auth.uid && member.status == "active"
        && supportedMemberRole(member.role) && member.permissions is map;
    }

    function sparkWorkerPermission(ownerUid, businessId, moduleName, action) {
      let member = businessUnitMemberData(ownerUid, businessId);
      return signedIn() && request.auth.uid != ownerUid && workersFeatureFlagEnabled(ownerUid)
        && exists(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/members/$(request.auth.uid))
        && validBusinessUnitIdentity(member, ownerUid, businessId)
        && member.uid == request.auth.uid && member.status == "active"
        && supportedMemberRole(member.role) && member.permissions is map
        && member.permissions.get(moduleName, {}).get(action, false) == true;
    }

    function sparkPermission(ownerUid, businessId, moduleName, action) {
      return sparkOwner(ownerUid) || sparkWorkerPermission(ownerUid, businessId, moduleName, action);
    }

    function sparkOperational(ownerUid, businessId) {
      let c = get(sparkControlPath(ownerUid)).data;
      return c.storageMode == "modular" && c.phase == "MODULAR" && c.schemaVersion == 2
        && c.semanticEquality == "PASS" && c.reconstructedHash == c.sourceHash
        && businessId in c.businessIds;
    }

    function sparkAfter(ownerUid, businessId, moduleName, recordId) {
      return getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/$(moduleName)/$(recordId)).data;
    }

    function sparkLedger(ownerUid, businessId, operationId) {
      return getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/operationLedger/$(operationId)).data.data;
    }

    function sparkNewLedger(ownerUid, businessId, operationId) {
      return operationId is string && operationId.size() > 0
        && !exists(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/operationLedger/$(operationId));
      // Every caller ALSO executes its module mutation proof, which reads
      // getAfter(ledger).kind/result. An absent post-write ledger fails that
      // proof. Its CREATE rule certifies status/mode/permissions atomically.
      // Repeating existsAfter here adds no invariant, only evaluation cost.
    }

    function sparkValidOperationalRecord(ownerUid, businessId, moduleName, recordId) {
      let d = request.resource.data;
      return d.keys().hasOnly(["id", "ownerUid", "businessId", "schemaVersion", "module", "sourceHash", "sourcePath", "data", "dataHash",
          "recordVersion", "createdAt", "updatedAt", "closedAt", "createdBy", "updatedBy", "lastOperationId", "operational", "operationalHash", "saleStockIndex"])
        && [d.id, d.ownerUid, d.businessId, d.schemaVersion, d.module] == [recordId, ownerUid, businessId, 2, moduleName]
        && [d.data.id, d.data.businessId] == [recordId, businessId]
        && d.data is map && d.dataHash is string && d.dataHash.matches("^[a-f0-9]{64}$")
        && d.recordVersion is int
        && d.updatedBy == request.auth.uid && d.updatedAt == request.time
        ;
    }

    function sparkOperationalCreate(ownerUid, businessId, moduleName, recordId) {
      // The new immutable ledger certifies mode and permissions once for the
      // entire atomic commit. Related records cannot exist without that ledger.
      return sparkValidOperationalRecord(ownerUid, businessId, moduleName, recordId)
        && request.resource.data.recordVersion == 1 && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !request.resource.data.keys().hasAny(["sourceHash", "sourcePath"]);
    }

    function sparkOperationalUpdate(ownerUid, businessId, moduleName, recordId) {
      let d = request.resource.data;
      return sparkValidOperationalRecord(ownerUid, businessId, moduleName, recordId)
        && resource.data.get("recordVersion", 1) >= 1
        && d.recordVersion == resource.data.get("recordVersion", 1) + 1
        && d.createdAt == resource.data.get("createdAt", request.time)
        && d.createdBy == resource.data.get("createdBy", request.auth.uid)
        && d.get("sourceHash", "") == resource.data.get("sourceHash", "")
        && d.get("sourcePath", []) == resource.data.get("sourcePath", []);
    }

    function sparkKindPermission(ownerUid, businessId, kind) {
      return kind in ["sale", "product_create", "product_edit", "inventory_adjust", "cash_open", "cash_close", "cash_reopen", "cash_movement", "customer_create", "customer_edit", "customer_delete", "receivable_payment"]
        && sparkPermission(ownerUid, businessId,
          kind == "receivable_payment" ? "layaways" : (kind in ["customer_create", "customer_edit", "customer_delete"] ? "customers" : (kind == "sale" ? "sales" : (kind in ["product_create", "product_edit", "inventory_adjust"] ? "products" :
            (kind == "cash_movement" ? "movements" : "cashSessions")))),
          kind == "receivable_payment" ? "payment" : (kind == "customer_delete" ? "delete" : (kind in ["sale", "product_create", "cash_open", "cash_movement", "customer_create"] ? "create" :
            (kind in ["product_edit", "inventory_adjust", "cash_reopen", "customer_edit"] ? "update" : "close"))));
    }

    function sparkBoundOperation(ownerUid, businessId) {
      let op = request.resource.data.lastOperationId;
      // Permission is certified once by the immutable ledger CREATE rule.
      // Every related record binds to that NEW ledger in this atomic write;
      // a denied ledger rejects the entire transaction, not just its receipt.
      return sparkNewLedger(ownerUid, businessId, op);
    }

    function sparkLedgerProof(ownerUid, businessId, operationId) {
      let d = request.resource.data.data;
      let r = d.result;
      let kind = d.kind;
      return sparkOperational(ownerUid, businessId)
        && d.keys().hasOnly(["id", "businessId", "operationId", "kind", "status", "payloadHash", "result"])
        && d.operationId == operationId && d.status == "committed" && d.payloadHash is string && d.payloadHash.matches("^[a-f0-9]{64}$")
        && sparkKindPermission(ownerUid, businessId, kind)
        && (kind == "sale" ? sparkSaleLedgerProof(ownerUid, businessId, operationId, r)
          : kind in ["customer_create", "customer_edit", "customer_delete"] ? (r.keys().hasOnly(["customerId"])
            && getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/customers/$(r.customerId)).data.lastOperationId == operationId)
          : kind in ["product_create", "product_edit", "inventory_adjust"] ?
            (getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/products/$(r.productId)).data.lastOperationId == operationId
              && (kind == "product_edit" || (kind == "product_create"
                && getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/products/$(r.productId)).data.data.stock == 0)
                || getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/movements/$(operationId)).data.lastOperationId == operationId))
          : kind in ["cash_open", "cash_close", "cash_reopen", "cash_movement"] ?
            (getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/cashSessions/$(r.cashSessionId)).data.lastOperationId == operationId
              && (kind != "cash_close" || (!exists(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/dailyReports/$(r.reportId))
                && getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/dailyReports/$(r.reportId)).data.data.operationId == operationId))
              && (kind != "cash_reopen" || getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/dailyReports/$(r.reportId)).data.lastOperationId == operationId))
          : kind == "receivable_payment" ? sparkPaymentLedgerProof(ownerUid, businessId, operationId, r) : false);
    }

    function sparkReceivableLedgerProof(ownerUid, businessId, operationId) {
      let d = request.resource.data.data;
      return sparkOperational(ownerUid, businessId)
        && d.keys().hasOnly(["id", "businessId", "operationId", "kind", "status", "payloadHash", "result"])
        && d.operationId == operationId && d.kind == "receivable_payment" && d.status == "committed"
        && d.payloadHash is string && d.payloadHash.matches("^[a-f0-9]{64}$")
        // The existing cashier contract grants collection via payment,
        // not general sale editing. UPDATE fields stay strictly bounded.
        && sparkPermission(ownerUid, businessId, "layaways", "payment")
        && sparkPaymentLedgerProof(ownerUid, businessId, operationId, d.result);
    }

    function sparkPaymentLedgerProof(ownerUid, businessId, op, result) {
      return request.resource.data.get("module", "") == "operationLedger"
        && request.resource.data.get("data", {}).get("kind", "") == "receivable_payment"
        && sparkPaymentLedgerLinks(ownerUid, businessId, op, result);
    }

    function sparkPaymentLedgerLinks(ownerUid, businessId, op, result) {
      let sale = sparkAfter(ownerUid, businessId, "sales", result.saleId);
      let movement = sparkAfter(ownerUid, businessId, "movements", op);
      let session = sparkAfter(ownerUid, businessId, "cashSessions", result.cashSessionId);
      return result.keys().hasOnly(["saleId", "movementId", "cashSessionId", "layawayId"])
        && result.movementId == op && movement.lastOperationId == op && sale.lastOperationId == op && session.lastOperationId == op
        && !exists(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/movements/$(op))
        && movement.data.saleId == result.saleId && movement.data.cashSessionId == result.cashSessionId
        && (sale.data.method == "Apartado" ? (result.layawayId == sale.data.layawayId
          && sparkAfter(ownerUid, businessId, "layaways", result.layawayId).lastOperationId == op) : !result.keys().hasAny(["layawayId"]));
    }

    function sparkPaymentSaleMutation(ownerUid, businessId, recordId) {
      return resource != null && resource.data is map
        && resource.data.get("data", {}).get("status", "") in ["layaway", "pending_payment"]
        && sparkPaymentSaleDelta(ownerUid, businessId, recordId);
    }

    function sparkPaymentSaleDelta(ownerUid, businessId, recordId) {
      let d = request.resource.data.data;
      let old = resource.data.data;
      let op = request.resource.data.lastOperationId;
      let movement = sparkAfter(ownerUid, businessId, "movements", op).data;
      let before = old.get("payments", []);
      return sparkLedger(ownerUid, businessId, op).kind == "receivable_payment"
        && old.status in ["layaway", "pending_payment"] && old.balance > 0
        && sparkMoneyEqual(old.received + old.balance, old.total)
        && d.diff(old).affectedKeys().hasOnly(["received", "balance", "payments", "status"])
        && movement.saleId == recordId && movement.paymentType == "receivable_payment" && movement.amount > 0 && movement.amount <= old.balance
        && sparkMoneyEqual(d.received, old.received + movement.amount) && sparkMoneyEqual(d.balance, old.balance - movement.amount)
        && d.status == (d.balance == 0 ? "paid" : old.status)
        && d.payments is list && d.payments.size() == before.size() + 1
        && d.payments[d.payments.size() - 1] == movement.payment
        && d.payments.toSet() == before.toSet().union([movement.payment].toSet());
    }

    function sparkPaymentMovement(ownerUid, businessId, op, movement) {
      // A denied composite write can evaluate alternate proof branches.
      // Reject the local non-receipt shape BEFORE entering a helper with
      // getAfter let bindings. This is a reject-only guard, not permission.
      return movement.keys().hasAll(["payment"])
        && sparkPaymentMovementProof(ownerUid, businessId, op, movement);
    }

    function sparkPaymentMovementProof(ownerUid, businessId, op, movement) {
      let session = sparkAfter(ownerUid, businessId, "cashSessions", movement.cashSessionId);
      return movement.keys().hasOnly(["id", "businessId", "operationId", "saleId", "cashSessionId", "date", "kind", "amount", "paymentMethod", "paymentType", "payment"])
        && movement.kind == "ingreso" && movement.amount > 0 && movement.paymentMethod in ["Efectivo", "Tarjeta", "Transferencia"]
        && movement.paymentType == "receivable_payment" && session.lastOperationId == op && session.data.status == "open" && session.data.date == movement.date
        && movement.payment == {"id": op, "operationId": op, "date": movement.date, "amount": movement.amount,
          "method": movement.paymentMethod, "createdBy": request.auth.uid};
    }

    function sparkPaymentSessionMutation(ownerUid, businessId, op, counters) {
      return request.resource.data.get("module", "") == "cashSessions"
        && sparkPaymentSessionShape(ownerUid, businessId, op, counters);
    }

    function sparkPaymentSessionShape(ownerUid, businessId, op, counters) {
      let changed = counters.diff(resource.data.operational).affectedKeys();
      return changed.hasOnly(["cashBalance", "paymentTotals"]) && changed.hasAny(["paymentTotals"])
        && sparkPaymentSessionDelta(ownerUid, businessId, op, counters);
    }

    function sparkPaymentSessionDelta(ownerUid, businessId, op, counters) {
      let movement = sparkAfter(ownerUid, businessId, "movements", op).data;
      let old = resource.data.operational;
      let p = counters.paymentTotals;
      return movement.cashSessionId == request.resource.data.id && movement.date == resource.data.data.date
        && p.keys().hasOnly(["cash", "card", "transfer", "receivablePayments"])
        && sparkMoneyEqual(counters.cashBalance, old.cashBalance + (movement.paymentMethod == "Efectivo" ? movement.amount : 0))
        && sparkMoneyEqual(p.cash, old.paymentTotals.cash + (movement.paymentMethod == "Efectivo" ? movement.amount : 0))
        && sparkMoneyEqual(p.card, old.paymentTotals.card + (movement.paymentMethod == "Tarjeta" ? movement.amount : 0))
        && sparkMoneyEqual(p.transfer, old.paymentTotals.transfer + (movement.paymentMethod == "Transferencia" ? movement.amount : 0))
        && sparkMoneyEqual(p.receivablePayments, old.paymentTotals.receivablePayments + movement.amount);
    }

    function sparkPaymentLayawayMutation(ownerUid, businessId, recordId) {
      return resource != null && resource.data is map
        && resource.data.get("data", {}).get("saleId", "") != ""
        && sparkPaymentLayawayDelta(ownerUid, businessId, recordId);
    }

    function sparkPaymentLayawayDelta(ownerUid, businessId, recordId) {
      let d = request.resource.data.data;
      let ledger = sparkLedger(ownerUid, businessId, request.resource.data.lastOperationId);
      let sale = sparkAfter(ownerUid, businessId, "sales", d.saleId).data;
      return ledger.kind == "receivable_payment" && ledger.result.layawayId == recordId && sale.layawayId == recordId
        && d.diff(resource.data.data).affectedKeys().hasOnly(["paid", "balance", "payments", "status"])
        && d.paid == sale.received && d.balance == sale.balance && d.payments == sale.payments
        && d.status == (d.balance == 0 ? "paid" : "partially_paid");
    }

    function sparkSaleLedgerProof(ownerUid, businessId, operationId, result) {
      let sale = getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/sales/$(operationId)).data.data;
      let movement = getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/movements/$(operationId)).data.data;
      return result.keys().hasOnly(["saleId", "movementId", "cashSessionId", "layawayId"])
        && [result.saleId, result.movementId, result.cashSessionId] == [operationId, operationId, sale.cashSessionId]
        && (sale.method == "Apartado" ? result.layawayId == sale.layawayId : !result.keys().hasAny(["layawayId"]))
        && !exists(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/sales/$(operationId))
        && !exists(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/movements/$(operationId))
        && [sale.operationId, movement.operationId] == [operationId, operationId]
        && sparkCustomSalePart(sale, 0);
    }

    function sparkMoneyEqual(actual, expected) {
      // Subtraction itself rejects missing/non-numeric operands in Rules.
      // Same strict tolerance on BOTH sides, with one native comparison.
      // This helper is called repeatedly by a single atomic cash update.
      return math.abs(actual - expected) < 0.000001;
    }

    function sparkDerivedAudit(ownerUid, businessId, recordId) {
      let d = request.resource.data.data;
      let ledger = get(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/operationLedger/$(d.operationId)).data;
      return sparkOperational(ownerUid, businessId)
        && (sparkOwner(ownerUid) || (ledger.createdBy == request.auth.uid && sparkActiveMember(ownerUid, businessId)))
        && ledger.data.status == "committed" && ledger.data.operationId == d.operationId
        && recordId == "audit-" + d.operationId && request.resource.data.lastOperationId == d.operationId
        && d.keys().hasOnly(["id", "businessId", "operationId", "action", "actorUid", "payloadHash", "lastOperationId"])
        && d.action == ledger.data.kind && d.actorUid == ledger.createdBy && d.payloadHash == ledger.data.payloadHash;
    }

    function sparkSalePayments(ownerUid, businessId, op, counters) {
      let movement = getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/movements/$(op)).data.data;
      let previous = resource.data.operational;
      return movement.paymentMethod in ["Efectivo", "Tarjeta", "Transferencia", "Pendiente"]
        && movement.paymentType in ["sale", "receivable_payment"]
        && sparkMoneyEqual(counters.cashBalance, previous.cashBalance + (movement.paymentMethod == "Efectivo" ? movement.amount : 0))
        && counters.paymentTotals.keys().hasOnly(["cash", "card", "transfer", "receivablePayments"])
        && sparkMoneyEqual(counters.paymentTotals.cash, previous.paymentTotals.cash + (movement.paymentMethod == "Efectivo" ? movement.amount : 0))
        && sparkMoneyEqual(counters.paymentTotals.card, previous.paymentTotals.card + (movement.paymentMethod == "Tarjeta" ? movement.amount : 0))
        && sparkMoneyEqual(counters.paymentTotals.transfer, previous.paymentTotals.transfer + (movement.paymentMethod == "Transferencia" ? movement.amount : 0))
        && sparkMoneyEqual(counters.paymentTotals.receivablePayments, previous.paymentTotals.receivablePayments + (movement.paymentType == "receivable_payment" ? movement.amount : 0));
    }

    function sparkCashMovementTotals(ownerUid, businessId, op, counters) {
      let movement = getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/movements/$(op)).data.data;
      let previous = resource.data.operational;
      return movement.cashSessionId == request.resource.data.id && movement.date == request.resource.data.data.date
        && sparkMoneyEqual(counters.cashBalance, previous.cashBalance + (movement.kind == "ingreso" ? movement.amount : -movement.amount))
        && sparkMoneyEqual(counters.incomeCash, previous.incomeCash + (movement.kind == "ingreso" ? movement.amount : 0))
        && sparkMoneyEqual(counters.expenseCash, previous.expenseCash + (movement.kind == "ingreso" ? 0 : movement.amount));
    }

    // Every stock-bearing sale points to the first product; each product write
    // proves the next write with a strictly increasing index. This closes the
    // omitted-product hole without enumerating a fixed number of cart lines.
    // A stale product cannot satisfy a NEW operation's lastOperationId.
    function sparkStockSuccessor(ownerUid, businessId, op, order, index) {
      let next = getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/products/$(order[index + 1])).data;
      return next.lastOperationId == op && next.saleStockIndex == index + 1;
    }

    function sparkStockChain(ownerUid, businessId, recordId, op, order) {
      let index = request.resource.data.saleStockIndex;
      return index is int && index >= 0 && index < order.size()
        && order[index] == recordId
        && (index == order.size() - 1 ? true : sparkStockSuccessor(ownerUid, businessId, op, order, index));
    }

    function sparkStockHead(ownerUid, businessId, op, order) {
      let first = getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/products/$(order[0])).data;
      return first.lastOperationId == op && first.saleStockIndex == 0;
    }

    function sparkProductSaleMutation(ownerUid, businessId, recordId, op) {
      let sale = getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/sales/$(op)).data.data;
      let itemIndex = sale.stockItemIndices[recordId];
      let line = sale.items[itemIndex];
      let d = request.resource.data.data;
      return sparkStockChain(ownerUid, businessId, recordId, op, sale.stockOrder)
        && itemIndex is int && itemIndex >= 0 && itemIndex < sale.items.size()
        && sale.itemOrder[itemIndex] == recordId
        && line.productId == recordId && line.get("id", recordId) == recordId && line.isCustom == false
        && line.qty is int && line.qty > 0 && line.qty == sale.stockDeltas[recordId]
        && d.diff(resource.data.data).affectedKeys().hasOnly(["stock", "qty", "id", "businessId"])
        && sale.stockDeltas[recordId] > 0 && d.stock == resource.data.data.stock - sale.stockDeltas[recordId];
    }

    function sparkProductMutation(ownerUid, businessId, recordId, creating) {
      let d = request.resource.data.data;
      let op = request.resource.data.lastOperationId;
      let ledger = sparkLedger(ownerUid, businessId, op);
      let kind = ledger.kind;
      return d.id == recordId && d.businessId == businessId && d.stock is number && d.stock >= 0 && d.qty == d.stock
        && (kind == "product_create" ? (creating && ledger.result.productId == recordId)
          : kind == "product_edit" ? (!creating && ledger.result.productId == recordId
              && d.diff(resource.data.data).affectedKeys().hasOnly(["code", "name", "category", "cost", "price", "cardPrice", "taxMode", "notes", "imageData"])
              && d.stock == resource.data.data.stock && d.qty == resource.data.data.qty)
          : kind == "inventory_adjust" ? (!creating && ledger.result.productId == recordId
              && d.diff(resource.data.data).affectedKeys().hasOnly(["code", "name", "category", "cost", "price", "cardPrice", "taxMode", "notes", "imageData", "stock", "qty"])
              && getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/movements/$(op)).data.data.productId == recordId
              && d.stock == resource.data.data.stock + getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/movements/$(op)).data.data.quantityDelta)
          : kind == "sale" ? (!creating
              && sparkProductSaleMutation(ownerUid, businessId, recordId, op)) : false);
    }

    function sparkSaleLine(d, index) {
      // Caller dispatches only existing indices. Do not evaluate the same
      // length guard twice per manual line in a compound financial write.
      let key = d.customOrder[index];
      let itemIndex = d.customItemIndices[key];
      let line = d.items[itemIndex];
      // Native list indexing rejects non-integer/out-of-range indices. The
      // tuple binds order, canonical ID, legacy alias and custom provenance
      // without repeating four equivalent boolean branches per line.
      return [d.itemOrder[itemIndex], line.productId, line.get("id", key), line.isCustom] == [key, key, key, true]
        && line.qty is int && line.qty > 0;
    }

    function sparkSaleLines(d) {
      return d.items.size() <= 12 && d.itemOrder is list && d.itemOrder.size() == d.items.size()
        && d.itemOrder.toSet().size() == d.items.size()
        && d.customOrder is list && d.customOrder.toSet().size() == d.customOrder.size()
        && d.stockItemIndices is map && d.customItemIndices is map
        && d.stockItemIndices.keys().toSet() == d.stockDeltas.keys().toSet()
        && d.customItemIndices.keys().toSet() == d.customOrder.toSet()
        && !d.stockItemIndices.keys().toSet().hasAny(d.customOrder)
        && d.itemOrder.toSet() == d.stockItemIndices.keys().toSet().union(d.customItemIndices.keys().toSet())
        && d.items.size() == d.stockItemIndices.size() + d.customItemIndices.size();
    }

    function sparkCustomSalePart(d, start) {
      let n = d.customOrder.size();
      // Mandatory core records share these proofs in the SAME new-ledger
      // atomic commit. Balance by validator work, not just number of rows:
      // 0..2 ledger; 3..5 sale; 6..9 movement; 10..11 exact session update.
      return n <= start ? true : sparkSaleLine(d, start)
        && (n <= start + 1 ? true : sparkSaleLine(d, start + 1)
          && (n <= start + 2 ? true : sparkSaleLine(d, start + 2)));
    }

    function sparkCustomSalePart4(d, start) {
      return sparkCustomSalePart(d, start)
        && (d.customOrder.size() <= start + 3 ? true : sparkSaleLine(d, start + 3));
    }

    function sparkSaleQuantity(d) {
      let items = d.items;
      let n = items.size();
      return items[0].qty + (n > 1 ? items[1].qty : 0) + (n > 2 ? items[2].qty : 0)
        + (n > 3 ? items[3].qty : 0) + (n > 4 ? items[4].qty : 0) + (n > 5 ? items[5].qty : 0)
        + (n > 6 ? items[6].qty : 0) + (n > 7 ? items[7].qty : 0) + (n > 8 ? items[8].qty : 0)
        + (n > 9 ? items[9].qty : 0) + (n > 10 ? items[10].qty : 0) + (n > 11 ? items[11].qty : 0);
    }

    function sparkSaleCounterDelta(ownerUid, businessId, op, counters) {
      let sale = getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/sales/$(op)).data.data;
      let previous = resource.data.operational;
      return sale.cashSessionId == request.resource.data.id && sale.date == request.resource.data.data.date
        && counters.saleCount == previous.saleCount + 1
        && counters.itemCount == previous.itemCount + sale.itemCount
        && sparkMoneyEqual(counters.taxTotal, previous.taxTotal + sale.iva)
        && sparkMoneyEqual(counters.salesTotal, previous.salesTotal + sale.total)
        && (sale.customOrder.size() <= 10 ? true : (sparkSaleLine(sale, 10)
          && (sale.customOrder.size() <= 11 ? true : sparkSaleLine(sale, 11))));
    }

    function sparkSaleMutation(ownerUid, businessId, recordId) {
      let d = request.resource.data.data;
      let session = getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/cashSessions/$(d.cashSessionId)).data;
      return sparkLedger(ownerUid, businessId, recordId).kind == "sale"
        && request.resource.data.lastOperationId == recordId
        && d.operationId == recordId && d.cashSessionId is string && d.cashSessionId.size() > 0
        && d.total is number && d.total >= 0 && d.received is number && d.received >= 0 && d.received <= d.total
        && sparkMoneyEqual(d.balance, d.total - d.received)
        && (d.method == "Apartado" ? d.status == "layaway"
          : (d.method == "Pendiente" ? (d.status == "pending_payment" && d.received == 0)
            : (d.method in ["Efectivo", "Tarjeta", "Transferencia"] && d.status == "paid" && d.received == d.total)))
        && (d.method == "Apartado" ? sparkSaleLayaway(ownerUid, businessId, recordId, d)
          : !d.keys().hasAny(["layawayId"]))
        && d.items is list && d.items.size() > 0 && d.stockDeltas is map
        && sparkSaleLines(d) && sparkCustomSalePart(d, 3)
        && d.itemCount is int && d.iva is number && d.iva >= 0
        && d.stockOrder is list && d.stockOrder.toSet() == d.stockDeltas.keys().toSet()
        && d.stockOrder.size() == d.stockDeltas.size()
        && (d.stockOrder.size() == 0 ? true : sparkStockHead(ownerUid, businessId, recordId, d.stockOrder))
        && session.data.status == "open" && session.data.date == d.date && session.lastOperationId == recordId
        // Require a NEW exact-session update even if a malformed/imported old
        // record happened to carry this operation ID. Its update rule owns
        // the final manual-line proof and every authoritative counter delta.
        && session.recordVersion == get(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/cashSessions/$(d.cashSessionId)).data.get("recordVersion", 1) + 1;
    }

    function sparkSaleLayaway(ownerUid, businessId, operationId, sale) {
      let linked = getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/layaways/$(sale.layawayId)).data;
      // A pre-existing reservation cannot authorize a second sale. The new
      // linked record's CREATE rule proves amounts and permission atomically.
      return sale.layawayId is string && sale.layawayId.size() > 0
        && !exists(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/layaways/$(sale.layawayId))
        && linked.lastOperationId == operationId && linked.data.saleId == operationId;
    }

    function sparkLayawayMutation(ownerUid, businessId, recordId) {
      let d = request.resource.data.data;
      let op = request.resource.data.lastOperationId;
      let ledger = sparkLedger(ownerUid, businessId, op);
      let sale = getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/sales/$(op)).data.data;
      return ledger.kind == "sale" && ledger.result.layawayId == recordId
        && sparkPermission(ownerUid, businessId, "layaways", "create")
        && sale.method == "Apartado" && sale.layawayId == recordId && d.saleId == op
        && d.total == sale.total && d.paid == sale.received && d.balance == sale.balance;
    }

    function sparkCashMutation(ownerUid, businessId, recordId, creating) {
      let d = request.resource.data.data;
      let counters = request.resource.data.operational;
      let op = request.resource.data.lastOperationId;
      let kind = sparkLedger(ownerUid, businessId, op).kind;
      return counters.summaryVersion == 1 && counters.saleCount is int && counters.saleCount >= 0
        && counters.salesTotal is number && counters.salesTotal >= 0 && counters.paymentTotals is map
        && counters.cashBalance is number && counters.closeCycle is int && counters.closeCycle >= 1
        && request.resource.data.operationalHash is string && request.resource.data.operationalHash.matches("^[a-f0-9]{64}$")
        && d.date is string && d.status in ["open", "closed"]
        && (kind == "cash_open" ? (creating && counters.saleCount == 0 && counters.salesTotal == 0
              && counters.itemCount == 0 && counters.taxTotal == 0 && counters.incomeCash == 0 && counters.expenseCash == 0 && counters.closeCycle == 1
              && counters.paymentTotals == {"cash": 0, "card": 0, "transfer": 0, "receivablePayments": 0}
              && counters.openingAmount is number && counters.openingAmount >= 0
              && getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/movements/$(op)).data.lastOperationId == op
              && d.status == "open" && counters.cashBalance == counters.openingAmount
              && getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/metadata/$("runtime")).data.data.openCashSessionId == recordId)
          : kind == "sale" ? (!creating && resource.data.data.status == "open" && d.status == "open"
              && d.date == resource.data.data.date
              && d == resource.data.data
              && counters.diff(resource.data.operational).affectedKeys().hasOnly(["saleCount", "salesTotal", "itemCount", "taxTotal", "cashBalance", "paymentTotals"])
              && sparkSaleCounterDelta(ownerUid, businessId, op, counters)
              && sparkSalePayments(ownerUid, businessId, op, counters)
              )
          : kind == "receivable_payment" ? (!creating && resource.data.data.status == "open" && d == resource.data.data
              && sparkPaymentSessionMutation(ownerUid, businessId, op, counters))
          : kind == "cash_close" ? (!creating && resource.data.data.status == "open" && d.status == "closed"
              && d.diff(resource.data.data).affectedKeys().hasOnly(["status", "reportId"])
              && counters == resource.data.operational
              && getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/dailyReports/$(d.reportId)).data.data.cashSessionId == recordId
              && getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/metadata/$("runtime")).data.data.openCashSessionId == "")
          : kind == "cash_reopen" ? (!creating && resource.data.data.status == "closed" && d.status == "open"
              && d.diff(resource.data.data).affectedKeys().hasOnly(["status"])
              && counters.closeCycle == resource.data.operational.closeCycle + 1
              && counters.diff(resource.data.operational).affectedKeys().hasOnly(["closeCycle"])
              && getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/metadata/$("runtime")).data.data.openCashSessionId == recordId)
          : kind == "cash_movement" ? (!creating && resource.data.data.status == "open" && d.status == "open"
              && d == resource.data.data
              && counters.diff(resource.data.operational).affectedKeys().hasOnly(["cashBalance", "incomeCash", "expenseCash"])
              && sparkCashMovementTotals(ownerUid, businessId, op, counters)
              && counters.saleCount == resource.data.operational.saleCount && counters.salesTotal == resource.data.operational.salesTotal) : false);
    }

    function sparkMovementMutation(ownerUid, businessId, recordId) {
      let d = request.resource.data.data;
      let ledger = sparkLedger(ownerUid, businessId, recordId);
      let kind = ledger.kind;
      return request.resource.data.lastOperationId == recordId
        && d.id == recordId && d.businessId == businessId && d.operationId == recordId
        && d.amount is number && d.amount >= 0 && d.date is string
        // Dispatch from the immutable ledger, not overlapping OR proofs.
        // A rejected sale must not evaluate receipt-only cross-record reads.
        && (kind == "sale" ? (d.saleId == recordId
              && sparkSaleMovement(ownerUid, businessId, recordId, d))
          : kind == "inventory_adjust" ? (d.kind == "inventory_adjustment"
              && d.productId == ledger.result.productId && d.quantityDelta is number && d.quantityDelta != 0 && d.amount == 0)
          : kind == "product_create" ? (d.kind == "inventory_opening"
              && d.productId == ledger.result.productId && d.quantityDelta > 0 && d.amount == 0
              && d.quantityDelta == getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/products/$(d.productId)).data.data.stock)
          : kind == "cash_open" ? (d.kind == "apertura" && d.cashSessionId == ledger.result.cashSessionId
              && d.amount == getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/cashSessions/$(d.cashSessionId)).data.operational.openingAmount)
          : kind == "cash_movement" ? (d.kind in ["ingreso", "egreso", "retiro", "compra"]
              && d.cashSessionId == ledger.result.cashSessionId)
          : kind == "receivable_payment" ? sparkPaymentMovement(ownerUid, businessId, recordId, d) : false);
    }

    function sparkSaleMovement(ownerUid, businessId, recordId, movement) {
      let sale = getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/sales/$(recordId)).data.data;
      // The ledger requires this NEW movement and sale in the same commit.
      // Distribute cross-record proofs between their CREATE rules, never
      // between separate commits: a rejected manual line rejects all writes.
      return movement.saleId == recordId && movement.cashSessionId == sale.cashSessionId && movement.date == sale.date
        && movement.kind == "ingreso" && movement.amount == sale.received
        && movement.paymentType == (sale.method == "Apartado" ? "receivable_payment" : "sale")
        && (sale.received == 0 ? movement.paymentMethod == "Pendiente"
          : (sale.method == "Apartado" ? movement.paymentMethod in ["Efectivo", "Tarjeta", "Transferencia"] : movement.paymentMethod == sale.method))
        && sale.itemCount == sparkSaleQuantity(sale)
        && sparkCustomSalePart4(sale, 6);
    }

    function sparkReportMutation(ownerUid, businessId, recordId, creating) {
      let d = request.resource.data.data;
      let op = request.resource.data.lastOperationId;
      let ledger = sparkLedger(ownerUid, businessId, op);
      let session = getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/cashSessions/$(d.cashSessionId)).data;
      return d.id == recordId && d.businessId == businessId && ledger.result.reportId == recordId
        && ledger.result.cashSessionId == d.cashSessionId && session.lastOperationId == op
        && ((creating && ledger.kind == "cash_close" && session.data.status == "closed"
              && d.keys().hasOnly(["id", "businessId", "operationId", "cashSessionId", "date", "status", "renderVersion", "openingAmount", "closeCash", "declaredCash", "theoreticalCash", "difference", "saleCount", "total", "totalItems", "totalIva", "incomeCash", "expenseCash", "paymentTotals", "observations", "closeCycle", "lastOperationId"])
              && session.data.reportId == recordId && d.status == "closed"
              && d.total == session.operational.salesTotal && d.saleCount == session.operational.saleCount
              && d.theoreticalCash == session.operational.cashBalance && d.paymentTotals == session.operational.paymentTotals
              && d.openingAmount == session.operational.openingAmount && d.incomeCash == session.operational.incomeCash && d.expenseCash == session.operational.expenseCash
              && d.totalItems == session.operational.itemCount && d.totalIva == session.operational.taxTotal && d.closeCycle == session.operational.closeCycle
              && d.declaredCash is number && d.declaredCash >= 0 && d.closeCash == d.declaredCash
              && sparkMoneyEqual(d.difference, d.declaredCash - d.theoreticalCash))
          || (!creating && ledger.kind == "cash_reopen" && session.data.status == "open"
              && d.status == "reopened" && d.diff(resource.data.data).affectedKeys().hasOnly(["status", "reopenReason"])));
    }

    function sparkRuntimeMutation(ownerUid, businessId, recordId) {
      let d = request.resource.data.data;
      let ledger = sparkLedger(ownerUid, businessId, request.resource.data.lastOperationId);
      let session = getAfter(/databases/$(database)/documents/businesses/$(ownerUid)/businessUnits/$(businessId)/storage/v2/cashSessions/$(ledger.result.cashSessionId)).data;
      return recordId == "runtime" && d.summaryVersion == 1
        && d.diff(resource.data.data).affectedKeys().hasOnly(["openCashSessionId"])
        && session.lastOperationId == request.resource.data.lastOperationId
        && ((ledger.kind in ["cash_open", "cash_reopen"] && resource.data.data.openCashSessionId == ""
              && d.openCashSessionId == ledger.result.cashSessionId && session.data.status == "open")
          || (ledger.kind == "cash_close" && resource.data.data.openCashSessionId == ledger.result.cashSessionId
              && d.openCashSessionId == "" && session.data.status == "closed"));
    }

    function sparkCustomerMutation(ownerUid, businessId, recordId, creating) {
      let d = request.resource.data.data;
      let ledger = sparkLedger(ownerUid, businessId, request.resource.data.lastOperationId);
      return ledger.result.customerId == recordId
        // Imported rows can lack embedded IDs. Normalize only an absent ID;
        // an existing foreign ID/scope cannot be rewritten through CRUD.
        && (creating || sparkCustomerStoredIdentity(businessId, recordId))
        && (ledger.kind == "customer_delete" ? (!creating && d.deleted == true
            && resource.data.data.get("deleted", false) == false
            && d.diff(resource.data.data).affectedKeys().hasOnly(["deleted", "id", "businessId"]))
          : (ledger.kind == (creating ? "customer_create" : "customer_edit")
            && d.name is string && d.name.matches(".*[^\\s].*") && d.phone is string && d.notes is string
            && (creating ? d.keys().hasOnly(["id", "businessId", "name", "phone", "notes"])
              : resource.data.data.get("deleted", false) == false
                && d.diff(resource.data.data).affectedKeys().hasOnly(["name", "phone", "notes", "id", "businessId"]))));
    }

    function sparkCustomerStoredIdentity(businessId, recordId) {
      return resource != null && resource.data is map
        && [resource.data.data.get("id", recordId), resource.data.data.get("businessId", businessId)] == [recordId, businessId];
    }

    function sparkOperationalMutation(ownerUid, businessId, moduleName, recordId, creating) {
      return (moduleName == "operationLedger" && creating && sparkLedgerProof(ownerUid, businessId, recordId))
        || (moduleName == "products"
          && sparkProductMutation(ownerUid, businessId, recordId, creating))
        || (moduleName == "customers"
          && sparkCustomerMutation(ownerUid, businessId, recordId, creating))
        || (moduleName == "sales" && creating
          && sparkSaleMutation(ownerUid, businessId, recordId))
        || (moduleName == "movements" && creating
          && sparkMovementMutation(ownerUid, businessId, recordId))
        || (moduleName == "cashSessions"
          && sparkCashMutation(ownerUid, businessId, recordId, creating))
        || (moduleName == "dailyReports"
          && sparkReportMutation(ownerUid, businessId, recordId, creating))
        || (moduleName == "metadata" && !creating
          && sparkRuntimeMutation(ownerUid, businessId, recordId))
        || (moduleName == "auditEvents" && creating
          && recordId == "audit-" + request.resource.data.data.operationId
          && request.resource.data.data.actorUid == request.auth.uid
          && request.resource.data.data.action == sparkLedger(ownerUid, businessId, request.resource.data.data.operationId).kind);
    }

    function sparkValidShadow(ownerUid, businessId, moduleName, recordId) {
      let data = request.resource.data;
      return data.keys().hasOnly(["id", "ownerUid", "businessId", "schemaVersion", "module", "sourceHash", "sourcePath", "data", "dataHash"])
        && data.ownerUid == ownerUid && data.businessId == businessId
        && data.schemaVersion == 2 && data.module == moduleName && data.id == recordId
        && data.sourceHash == get(sparkControlPath(ownerUid)).data.sourceHash
        && data.sourcePath is list && data.sourcePath.size() > 0
        && data.dataHash is string && data.dataHash.size() == 64;
    }

    function sparkShadowModule(moduleName) {
      // Exact anchored whitelist, not a prefix grant. Keep the same module set
      // in one constant; regression tests verify parity and reject prefixes.
      // This optimization alone does NOT resolve compound-denial budget costs.
      return moduleName.matches("^(products|sales|movements|cashSessions|dailyReports|auditEvents|deletedProducts|supplierInvoices|layaways|tables|tableOrders|restaurantPayments|restaurantPrintHistory|restaurantEvents|restaurantRecipes|labelPrintHistory|legacyOperationLedger|customers|labelTemplates|labelProfiles|reminders|logisticsVehicles|logisticsRoutes|logisticsLoadSheets|logisticsRouteSales|logisticsCollections|logisticsReturns|logisticsSettlements|logisticsRouteExpenses|logisticsRouteCustomers|logisticsEvents|logisticsPrintHistory|financePayments|financeLoans|financeEnvelopes|financeGoals|config)$");
    }

    function validStatePayload() {
      return request.resource.data.payload.keys().hasAll(["schemaVersion", "identity", "data"])
        && request.resource.data.payload.data.keys().hasAll([
          "businesses", "products", "sales", "movements", "invoices", "dailyReports",
          "deletedProducts", "auditLogs", "settings"
        ])
        && request.resource.data.payload.data.businesses is list
        && request.resource.data.payload.data.businesses.size() > 0
        && request.resource.data.payload.data.products is list
        && request.resource.data.payload.data.sales is list
        && request.resource.data.payload.data.movements is list
        && request.resource.data.payload.data.invoices is list
        && request.resource.data.payload.data.dailyReports is list
        && request.resource.data.payload.data.deletedProducts is list
        && request.resource.data.payload.data.auditLogs is list
        && request.resource.data.payload.data.settings is map
        && request.resource.data.payload.data.settings.keys().hasAll(["workers", "labelTemplates"])
        && request.resource.data.payload.data.settings.workers is list
        && request.resource.data.payload.data.settings.labelTemplates is list
        && (!request.resource.data.payload.data.keys().hasAny(["layaways"]) || request.resource.data.payload.data.layaways is list)
        && (!request.resource.data.payload.data.keys().hasAny(["cashSessions"]) || request.resource.data.payload.data.cashSessions is list)
        && (!request.resource.data.payload.data.keys().hasAny(["notifications"]) || request.resource.data.payload.data.notifications is list)
        && (!request.resource.data.payload.data.keys().hasAny(["legalAcceptances"]) || request.resource.data.payload.data.legalAcceptances is list);
    }

    function writeMatchesTenant(businessId) {
      return businessId != "demo-click360"
        && request.resource.data.schemaVersion == 10
        && request.resource.data.ownerUid == businessId
        && request.resource.data.ownerId == businessId
        && request.resource.data.businessId == businessId
        && request.resource.data.tenantKey == "owner:" + businessId + ":business:" + businessId
        && request.resource.data.payload.schemaVersion == 10
        && request.resource.data.payload.identity.schemaVersion == 10
        && request.resource.data.payload.identity.ownerUid == businessId
        && request.resource.data.payload.identity.ownerId == businessId
        && request.resource.data.payload.identity.businessId == businessId
        && request.resource.data.payload.identity.tenantKey == "owner:" + businessId + ":business:" + businessId
        && validStatePayload();
    }

    function validWorkerUserCreate(uid) {
      return validV16WorkerUserCreate(uid) || (signedIn()
        && uid == request.auth.uid
        && request.auth.token.email != null
        && hasActiveInvite(request.auth.token.email)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == inviteData(request.auth.token.email).role
        && request.resource.data.ownerId == inviteData(request.auth.token.email).ownerId
        && request.resource.data.status == "active"
        && request.resource.data.approved == true
        && request.resource.data.isOwner != true
        && request.resource.data.keys().hasOnly([
          "uid", "email", "role", "ownerId", "name", "photoURL", "status",
          "approved", "businessLimit", "createdAt", "updatedAt", "approvedFromEmail", "isOwner"
        ]));
    }

    function validV16WorkerUserCreate(uid) {
      let ownerId = request.resource.data.ownerId;
      let inviteHash = request.resource.data.invitationHash;
      let invite = get(/databases/$(database)/documents/businesses/$(ownerId)/invitations/$(inviteHash)).data;
      let inviteAfter = getAfter(/databases/$(database)/documents/businesses/$(ownerId)/invitations/$(inviteHash)).data;
      let memberAfter = getAfter(/databases/$(database)/documents/businesses/$(ownerId)/members/$(uid)).data;
      return signedIn()
        && uid == request.auth.uid
        && ownerId != uid
        && ownerId != "demo-click360"
        && request.auth.token.email != null
        && invite.email == request.auth.token.email
        && invite.ownerId == ownerId
        && invite.businessId == ownerId
        && invite.inviteHash == inviteHash
        && invite.status == "pending"
        && invite.createdAt is timestamp
        && request.time < invite.createdAt + duration.value(invite.expiresAfterDays, "d")
        && inviteAfter.status == "accepted"
        && inviteAfter.acceptedBy == uid
        && inviteAfter.consumed == true
        && memberAfter.uid == uid
        && memberAfter.ownerId == ownerId
        && memberAfter.businessId == ownerId
        && (!invite.keys().hasAny(["businessUnitId"])
          || memberAfter.businessUnitId == invite.businessUnitId)
        && memberAfter.invitationHash == inviteHash
        && memberAfter.status == "active"
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.ownerId == ownerId
        && request.resource.data.businessId == ownerId
        && request.resource.data.tenantKey == "owner:" + ownerId + ":business:" + ownerId
        && request.resource.data.invitationHash == inviteHash
        && (!invite.keys().hasAny(["businessUnitId"])
          || request.resource.data.businessUnitId == invite.businessUnitId)
        && request.resource.data.role == invite.role
        && request.resource.data.permissions == invite.permissions
        && request.resource.data.status == "active"
        && request.resource.data.approved == true
        && request.resource.data.isOwner == false
        && request.resource.data.approvedFromInvitation == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "uid", "email", "name", "photoURL", "role", "permissions", "ownerId",
          "businessId", "businessUnitId", "tenantKey", "invitationHash", "status", "approved", "isOwner",
          "businessLimit", "workerLimit", "approvedFromInvitation", "createdAt", "updatedAt"
        ]);
    }

    function validProfileFields() {
      return request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 100000;
    }

    function ownProfileUpdateOnly(uid) {
      return approvedUser()
        && request.auth.uid == uid
        && validProfileFields()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "photoURL", "updatedAt"]);
    }

    function ownerRevokesWorker() {
      return ownerUser()
        && resource.data.ownerId == request.auth.uid
        && resource.data.role != "owner"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "approved", "revokedAt", "revokedBy", "updatedAt"])
        && (request.resource.data.status == "blocked" || request.resource.data.status == "revoked")
        && request.resource.data.approved == false
        && request.resource.data.revokedBy == request.auth.uid;
    }

    function ownerUpdatesWorkerAccess() {
      return ownerUser()
        && resource.data.ownerId == request.auth.uid
        && resource.data.role != "owner"
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.isOwner != true
        && supportedMemberRole(request.resource.data.role)
        && request.resource.data.permissions is map
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role", "permissions", "updatedAt"])
        && request.resource.data.updatedAt == request.time;
    }

    function validInviteWrite(email) {
      return ownerUser()
        && request.resource.data.email == email
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.role == "worker"
        && request.resource.data.status == "active"
        && request.resource.data.approved == true
        && request.resource.data.keys().hasOnly([
          "email", "role", "ownerId", "inviteToken", "status", "approved",
          "name", "businessLimit", "createdAt", "updatedAt"
        ]);
    }

    function validInviteRevoke() {
      return ownerUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "approved", "revokedAt", "revokedBy", "updatedAt"])
        && (request.resource.data.status == "blocked" || request.resource.data.status == "revoked")
        && request.resource.data.approved == false
        && request.resource.data.revokedBy == request.auth.uid;
    }

    match /approvedUsers/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || (ownerUser() && resource.data.ownerId == request.auth.uid && resource.data.role == "worker")
      );
      // Owner accounts are provisioned only by an administrative credential.
      allow create: if validWorkerUserCreate(uid);
      allow update: if ownProfileUpdateOnly(uid) || ownerRevokesWorker() || ownerUpdatesWorkerAccess();
      allow delete: if false;
    }

    match /approvedUsersByEmail/{email} {
      allow read: if signedIn() && (
        request.auth.token.email == email
        || (ownerUser() && resource.data.ownerId == request.auth.uid)
      );
      allow create: if validInviteWrite(email);
      allow update: if validInviteWrite(email) || validInviteRevoke();
      allow delete: if false;
    }

    match /accountAccess/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isPlatformAdmin();
      // CEO Admin Web: activation/plan-change/suspend writes for ANY tenant.
      // The exact field shape (status/planCode/limits/onboardingProfile/etc.)
      // is built by the single canonical activationFields() in
      // v16-domain.js -- the same function the CLI uses -- so this rule only
      // needs to enforce identity/plan-validity/monotonic-revision, not
      // re-derive the whole shape. app.js additionally writes a backup to
      // adminBackups and an entry to adminAuditLogs around every such write.
      allow create: if isPlatformAdmin()
        && uid != "demo-click360"
        && request.resource.data.uid == uid
        && request.resource.data.businessId == uid
        && request.resource.data.plan in ["base", "pro", "business", "enterprise", "founder_legacy"]
        && request.resource.data.revision == 1;
      allow update: if isPlatformAdmin()
        && uid != "demo-click360"
        && request.resource.data.uid == uid
        && request.resource.data.businessId == uid
        && request.resource.data.plan in ["base", "pro", "business", "enterprise", "founder_legacy"]
        && request.resource.data.revision is int
        && request.resource.data.revision > resource.data.revision;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          "uid", "ownerId", "businessId", "tenantKey", "email", "name", "photoURL", "status", "plan", "planCode", "trialDays",
          "trialStartedAt", "lastSeenAt", "createdAt", "source", "entitlementVersion", "revision"
        ])
        && request.resource.data.keys().hasOnly([
          "uid", "ownerId", "businessId", "tenantKey", "email", "name", "photoURL", "status", "plan", "planCode", "trialDays",
          "trialStartedAt", "profileUpdatedAt", "lastSeenAt", "createdAt", "source", "entitlementVersion", "revision"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.businessId == request.auth.uid
        && request.resource.data.tenantKey == "owner:" + request.auth.uid + ":business:" + request.auth.uid
        && request.resource.data.businessId != "demo-click360"
        && request.resource.data.email == request.auth.token.email
        && !exists(/databases/$(database)/documents/approvedUsers/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/approvedUsersByEmail/$(request.auth.token.email))
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && (!request.resource.data.keys().hasAny(["photoURL"])
          || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 100000))
        && request.resource.data.status == "trial"
        && request.resource.data.plan == "normal"
        && request.resource.data.planCode == "base"
        && request.resource.data.trialDays == 7
        && request.resource.data.source == "self_service"
        && request.resource.data.entitlementVersion == 16
        && request.resource.data.revision == 1
        && request.resource.data.trialStartedAt == request.time
        && (!request.resource.data.keys().hasAny(["profileUpdatedAt"])
          || request.resource.data.profileUpdatedAt == request.time)
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "photoURL", "profileUpdatedAt", "lastSeenAt"])
        && request.resource.data.lastSeenAt == request.time
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastSeenAt"])
          || (request.resource.data.profileUpdatedAt == request.time
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 120
            && (!request.resource.data.keys().hasAny(["photoURL"])
              || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 100000)))
        );
      allow delete: if false;
    }

    match /businesses/{businessId}/invitations/{inviteHash} {
      allow read: if businessId != "demo-click360" && signedIn() && (
        (ownerUser() && request.auth.uid == businessId)
        || (request.auth.token.email != null && resource.data.email == request.auth.token.email)
      );
      allow create: if businessId != "demo-click360"
        && ownerUser()
        && request.auth.uid == businessId
        && request.resource.data.keys().hasAll([
          "inviteHash", "email", "name", "role", "permissions", "ownerId", "businessId",
          "tenantKey", "status", "expiresAfterDays", "singleUse", "createdAt", "createdBy", "appVersion"
        ])
        && request.resource.data.keys().hasOnly([
          "inviteHash", "email", "name", "role", "permissions", "ownerId", "businessId", "businessUnitId",
          "tenantKey", "status", "expiresAfterDays", "singleUse", "createdAt", "createdBy", "appVersion"
        ])
        && request.resource.data.inviteHash == inviteHash
        && request.resource.data.ownerId == businessId
        && request.resource.data.businessId == businessId
        && (!request.resource.data.keys().hasAny(["businessUnitId"])
          || (request.resource.data.businessUnitId is string
            && request.resource.data.businessUnitId.size() > 0
            && request.resource.data.businessUnitId.size() <= 120))
        && request.resource.data.tenantKey == "owner:" + businessId + ":business:" + businessId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.name is string
        && supportedMemberRole(request.resource.data.role)
        && request.resource.data.permissions is map
        && request.resource.data.status == "pending"
        && request.resource.data.expiresAfterDays == 7
        && request.resource.data.singleUse == true
        && request.resource.data.createdAt == request.time
        && (request.resource.data.appVersion == "16.0.0" || request.resource.data.appVersion == "16.2.0");
      allow update: if businessId != "demo-click360" && (
        (ownerUser()
          && request.auth.uid == businessId
          && resource.data.ownerId == businessId
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.tenantKey == resource.data.tenantKey
          && request.resource.data.inviteHash == resource.data.inviteHash
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "revokedAt", "revokedBy", "role", "permissions", "updatedAt", "updatedBy"
          ])
          && supportedMemberRole(request.resource.data.role)
          && request.resource.data.permissions is map)
        || (signedIn()
          && request.auth.token.email != null
          && resource.data.email == request.auth.token.email
          && resource.data.status == "pending"
          && resource.data.createdAt is timestamp
          && request.time < resource.data.createdAt + duration.value(resource.data.expiresAfterDays, "d")
          && request.resource.data.status == "accepted"
          && request.resource.data.acceptedBy == request.auth.uid
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.consumed == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "acceptedBy", "acceptedAt", "consumed"])
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data.status == "active")
      );
      allow delete: if false;
    }

    match /businesses/{businessId}/ownerInviteSecrets/{inviteHash} {
      allow read: if businessId != "demo-click360"
        && ownerReadUser()
        && request.auth.uid == businessId;
      allow create, update: if businessId != "demo-click360"
        && ownerUser()
        && request.auth.uid == businessId
        && request.resource.data.ownerId == businessId
        && request.resource.data.inviteHash == inviteHash;
      allow delete: if false;
    }

    match /businesses/{businessId}/members/{uid} {
      allow read: if businessId != "demo-click360" && signedIn() && (
        (ownerReadUser() && request.auth.uid == businessId)
        || request.auth.uid == uid
      );
      allow create: if businessId != "demo-click360" && signedIn() && (
        (ownerUser() && request.auth.uid == businessId
          && request.resource.data.ownerId == businessId
          && request.resource.data.businessId == businessId
          && (!get(/databases/$(database)/documents/businesses/$(businessId)/invitations/$(request.resource.data.invitationHash)).data.keys().hasAny(["businessUnitId"])
            || request.resource.data.businessUnitId == get(/databases/$(database)/documents/businesses/$(businessId)/invitations/$(request.resource.data.invitationHash)).data.businessUnitId)
          && request.resource.data.uid == uid
          && request.resource.data.status == "active"
          && request.resource.data.role != "owner")
        || (request.auth.uid == uid
          && request.auth.token.email != null
          && request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.ownerId == businessId
          && request.resource.data.businessId == businessId
          && request.resource.data.tenantKey == "owner:" + businessId + ":business:" + businessId
          && request.resource.data.status == "active"
          && request.resource.data.role != "owner"
          && request.resource.data.permissions is map
          && get(/databases/$(database)/documents/businesses/$(businessId)/invitations/$(request.resource.data.invitationHash)).data.status == "pending"
          && get(/databases/$(database)/documents/businesses/$(businessId)/invitations/$(request.resource.data.invitationHash)).data.email == request.auth.token.email
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/invitations/$(request.resource.data.invitationHash)).data.status == "accepted"
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.lastAccessAt == request.time)
      );
      allow update: if businessId != "demo-click360"
        && ownerUser()
        && request.auth.uid == businessId
        && resource.data.ownerId == businessId
        && request.resource.data.ownerId == businessId
        && request.resource.data.businessId == businessId
        && request.resource.data.uid == uid
        && request.resource.data.role != "owner"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role", "permissions", "status", "updatedAt", "updatedBy", "revokedAt", "revokedBy"
        ]);
      allow delete: if false;
    }

    // Phase 3.2 per-tenant Workers rollout switch. Admin-provisioned and
    // admin-adjusted only (worker-boundary-migrate.mjs / worker-boundary-admin.mjs
    // via the Admin SDK, which bypasses rules) -- see workersFeatureFlagEnabled().
    // The owner may read their own tenant's flag (e.g. to show rollout status);
    // no client may ever write it.
    match /businesses/{ownerUid}/featureFlags/{docId} {
      allow read: if request.auth.uid == ownerUid || isPlatformAdmin();
      // CEO Admin Web: toggle the Workers flag for a tenant. Production
      // migrations already default this to false on creation (see
      // worker-boundary-migrate.mjs); this only lets the admin flip it once
      // a businessUnit is CUTOVER_VERIFIED, same effect as
      // worker-boundary-admin.mjs --action enable-workers, just from the browser.
      allow update: if isPlatformAdmin()
        && ownerUid != "demo-click360"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["enabled", "enabledAt", "enabledBy", "updatedBy", "updatedAt", "notes"]);
      allow create, delete: if false;
    }

    // Owner-initiated, immutable request log for additional worker seats
    // ("Trabajadores adicionales" screen), while no self-serve purchase
    // flow exists yet. The owner can only create their own request record;
    // fulfillment happens out-of-band via scripts/worker-boundary-admin.mjs
    // (which bypasses rules), not by writing back to this doc from a client.
    match /businesses/{ownerUid}/seatRequests/{requestId} {
      allow read: if request.auth.uid == ownerUid || isPlatformAdmin();
      allow create: if request.auth.uid == ownerUid
        && request.resource.data.ownerUid == ownerUid
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.businessId is string
        && request.resource.data.businessId.size() > 0
        && request.resource.data.requestedAt == request.time
        && request.resource.data.status == "pending";
      allow update, delete: if false;
    }

    // Commercial MVP: owner-initiated request for more products/storage
    // capacity, mirroring seatRequests exactly -- an immutable, auditable
    // record for AIIA, never mutated by the client, no billing automation.
    match /businesses/{ownerUid}/capacityRequests/{requestId} {
      allow read: if request.auth.uid == ownerUid || isPlatformAdmin();
      allow create: if request.auth.uid == ownerUid
        && request.resource.data.ownerUid == ownerUid
        && request.resource.data.requestedBy == request.auth.uid
        && (request.resource.data.kind == "products" || request.resource.data.kind == "storage")
        && request.resource.data.requestedAt == request.time
        && request.resource.data.status == "pending";
      allow update, delete: if false;
    }

    // Phase 3.3 activation evidence trail (worker-boundary-activate-tenant.mjs).
    // Admin-SDK-only, like adminBackups -- written before any mutation and
    // updated once at the end, never by a client.
    match /businesses/{ownerUid}/activationLog/{activationId} {
      allow read: if request.auth.uid == ownerUid || isPlatformAdmin();
      allow create, update, delete: if false;
    }

    // P2 modular boundary. The parent document is an administrative cutover
    // manifest. Public clients cannot create or promote a business unit.
    match /businesses/{ownerUid}/businessUnits/{businessId} {
      allow read: if businessUnitOwner(ownerUid, businessId)
        || activeBusinessUnitMember(ownerUid, businessId)
        || isPlatformAdmin();
      allow create, update, delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/members/{uid} {
      allow read: if businessUnitOwner(ownerUid, businessId)
        || (request.auth.uid == uid && activeBusinessUnitMember(ownerUid, businessId));
      // Seat gate: activation (create, or reactivation via update) must
      // consume exactly one seat in the same write via seatConsumedForSelf,
      // which independently re-checks capacity from the entitlement doc.
      allow create: if businessUnitReady(ownerUid, businessId)
        && request.auth.uid == uid
        && rootMembershipAfter(ownerUid).uid == request.auth.uid
        && rootMembershipAfter(ownerUid).status == "active"
        && supportedMemberRole(rootMembershipAfter(ownerUid).role)
        && validBoundaryCreate(ownerUid, businessId, "members", uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == rootMembershipAfter(ownerUid).role
        && request.resource.data.permissions == rootMembershipAfter(ownerUid).permissions
        && request.resource.data.status == "active"
        && seatConsumedForSelf(ownerUid, businessId);
      allow update: if sparkLegacyWritable(ownerUid) && request.resource.data.get("boundarySchemaVersion", 0) == 1 && businessUnitPermission(ownerUid, businessId, "members", "manage")
        && validBoundaryUpdate(ownerUid, businessId, "members", uid)
        && request.resource.data.uid == uid
        && supportedMemberRole(request.resource.data.role)
        && request.resource.data.permissions is map
        && (request.resource.data.status == "active" || request.resource.data.status == "revoked")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role", "permissions", "status", "recordVersion", "updatedBy", "updatedAt", "revokedBy", "revokedAt"
        ])
        && (
          resource.data.status == request.resource.data.status
          || (resource.data.status == "active" && request.resource.data.status == "revoked" && seatReleased(ownerUid, businessId))
          || (resource.data.status == "revoked" && request.resource.data.status == "active" && seatConsumedForSelf(ownerUid, businessId))
        );
      allow delete: if false;
    }

    // Seat entitlement counter for the P0 worker-seat commercial rule.
    // Provisioned only by the trusted migration admin process (bypasses
    // rules); clients may only move it by exactly +/-1 atomically alongside
    // the member write that earns/frees the seat (see seatConsumedForSelf
    // and seatReleased above), or, for the owner, to change the purchased
    // addOnSeats quota (no price is enforced here; that stays a business
    // decision made before calling this write).
    match /businesses/{ownerUid}/businessUnits/{businessId}/entitlement/{docId} {
      allow read: if businessUnitOwner(ownerUid, businessId)
        || activeBusinessUnitMember(ownerUid, businessId);
      allow create: if false;
      allow update: if docId == "seats" && validSeatEntitlementIdentity(request.resource.data, ownerUid, businessId) && (
        (businessUnitOwner(ownerUid, businessId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["addOnSeats", "updatedAt", "updatedBy"])
          && request.resource.data.addOnSeats is int
          && request.resource.data.addOnSeats >= 0
          && request.resource.data.activeMembers == resource.data.activeMembers
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activeMembers", "lastActionUid", "updatedAt", "updatedBy"])
          && request.resource.data.updatedAt == request.time
          && (
            (request.resource.data.updatedBy == request.auth.uid && seatConsumedForSelf(ownerUid, businessId))
            || (businessUnitPermission(ownerUid, businessId, "members", "manage") && seatReleased(ownerUid, businessId))
          ))
      );
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/products/{recordId} {
      allow read: if sparkLegacyReadable(ownerUid) && (businessUnitPermission(ownerUid, businessId, "products", "read")
        || businessUnitPermission(ownerUid, businessId, "sales", "read"));
      allow create: if request.resource.data.get("boundarySchemaVersion", 0) == 1 && businessUnitPermission(ownerUid, businessId, "products", "create")
        && validBoundaryCreate(ownerUid, businessId, "products", recordId)
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0;
      allow update: if resource.data.get("boundarySchemaVersion", 0) == 1
        && request.resource.data.get("boundarySchemaVersion", 0) == 1
        && validBoundaryUpdate(ownerUid, businessId, "products", recordId)
        && boundaryProductUpdateAllowed(ownerUid, businessId, recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/sales/{recordId} {
      allow read: if sparkLegacyReadable(ownerUid) && businessUnitPermission(ownerUid, businessId, "sales", "read");
      allow create: if request.resource.data.get("boundarySchemaVersion", 0) == 1 && businessUnitPermission(ownerUid, businessId, "sales", "create")
        && validBoundaryCreate(ownerUid, businessId, "sales", recordId)
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.items is list
        && request.resource.data.stockDeltas is map
        && request.resource.data.actorUid == request.auth.uid;
      allow update: if sparkLegacyWritable(ownerUid) && request.resource.data.get("boundarySchemaVersion", 0) == 1 && businessUnitPermission(ownerUid, businessId, "sales", "update")
        && validBoundaryUpdate(ownerUid, businessId, "sales", recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/layaways/{recordId} {
      allow read: if sparkLegacyReadable(ownerUid) && businessUnitPermission(ownerUid, businessId, "layaways", "read");
      allow create: if request.resource.data.get("boundarySchemaVersion", 0) == 1 && businessUnitPermission(ownerUid, businessId, "layaways", "create")
        && validBoundaryCreate(ownerUid, businessId, "layaways", recordId)
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0
        && request.resource.data.actorUid == request.auth.uid;
      allow update: if sparkLegacyWritable(ownerUid) && request.resource.data.get("boundarySchemaVersion", 0) == 1 && (
          (businessUnitPermission(ownerUid, businessId, "layaways", "update"))
          || (businessUnitPermission(ownerUid, businessId, "layaways", "payment")
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "payments", "paid", "balance", "status", "recordVersion", "updatedBy", "updatedAt"
            ])
            && resource.data.payments is list
            && request.resource.data.payments is list
            && request.resource.data.payments.size() == resource.data.payments.size() + 1
            && request.resource.data.payments[resource.data.payments.size()].amount is number
            && request.resource.data.payments[resource.data.payments.size()].amount > 0
            && request.resource.data.paid == resource.data.paid + request.resource.data.payments[resource.data.payments.size()].amount
            && request.resource.data.balance == resource.data.balance - request.resource.data.payments[resource.data.payments.size()].amount
            && request.resource.data.balance >= 0)
        ) && validBoundaryUpdate(ownerUid, businessId, "layaways", recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/cashSessions/{recordId} {
      allow read: if sparkLegacyReadable(ownerUid) && businessUnitPermission(ownerUid, businessId, "cashSessions", "read");
      allow create: if request.resource.data.get("boundarySchemaVersion", 0) == 1 && businessUnitPermission(ownerUid, businessId, "cashSessions", "create")
        && validBoundaryCreate(ownerUid, businessId, "cashSessions", recordId)
        && request.resource.data.actorUid == request.auth.uid;
      allow update: if sparkLegacyWritable(ownerUid) && request.resource.data.get("boundarySchemaVersion", 0) == 1 && (
          businessUnitPermission(ownerUid, businessId, "cashSessions", "update")
          || (businessUnitPermission(ownerUid, businessId, "cashSessions", "close")
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status", "closedAt", "closedBy", "countedCash", "expectedCash", "difference",
              "reportId", "observations", "recordVersion", "updatedBy", "updatedAt"
            ])
            && resource.data.status == "open"
            && request.resource.data.status == "closed"
            && request.resource.data.closedBy == request.auth.uid
            && request.resource.data.countedCash is number
            && request.resource.data.expectedCash is number
            && request.resource.data.difference == request.resource.data.countedCash - request.resource.data.expectedCash)
        ) && validBoundaryUpdate(ownerUid, businessId, "cashSessions", recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/movements/{recordId} {
      allow read: if sparkLegacyReadable(ownerUid) && businessUnitPermission(ownerUid, businessId, "movements", "read");
      allow create: if request.resource.data.get("boundarySchemaVersion", 0) == 1 && businessUnitPermission(ownerUid, businessId, "movements", "create")
        && validBoundaryCreate(ownerUid, businessId, "movements", recordId)
        && request.resource.data.amount is number
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/auditEvents/{recordId} {
      allow read: if sparkLegacyReadable(ownerUid) && businessUnitPermission(ownerUid, businessId, "auditEvents", "read");
      allow create: if request.resource.data.get("boundarySchemaVersion", 0) == 1 && businessUnitPermission(ownerUid, businessId, "auditEvents", "create")
        && validBoundaryCreate(ownerUid, businessId, "auditEvents", recordId)
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 80;
      allow update, delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/settings/{recordId} {
      allow read: if recordId == "main" && businessUnitPermission(ownerUid, businessId, "settings", "read");
      allow create: if recordId == "main"
        && businessUnitPermission(ownerUid, businessId, "settings", "create")
        && validBoundaryCreate(ownerUid, businessId, "settings", recordId);
      allow update: if recordId == "main"
        && businessUnitPermission(ownerUid, businessId, "settings", "update")
        && validBoundaryUpdate(ownerUid, businessId, "settings", recordId);
      allow delete: if false;
    }

    // r37.2 (LOGISTICS WORKER PERMISSIONS): logisticsVehicles/logisticsRoutes/
    // logisticsLoadSheets/logisticsRouteSales/logisticsCollections/
    // logisticsReturns/logisticsSettlements -- the modular per-record
    // collections a real Worker actually writes through (mirrors the
    // products/sales/etc. pattern above). Every write additionally
    // requires the fine-grained "logistics" module permission
    // (businessUnitPermission(..., "logistics", "<action>")) AND, for the
    // three personally-assignable capacities (seller/collector/helper),
    // that the requester is the exact uid assigned on the real route doc
    // -- "no basta esconder la tarjeta": a modified client cannot forge
    // its way around this by simply calling the write directly.
    match /businesses/{ownerUid}/businessUnits/{businessId}/logisticsVehicles/{recordId} {
      allow read: if sparkLegacyReadable(ownerUid) && businessUnitPermission(ownerUid, businessId, "logistics", "vehicles.read");
      allow create: if request.resource.data.get("boundarySchemaVersion", 0) == 1 && businessUnitPermission(ownerUid, businessId, "logistics", "vehicles.write")
        && validBoundaryCreate(ownerUid, businessId, "logisticsVehicles", recordId);
      allow update: if sparkLegacyWritable(ownerUid) && request.resource.data.get("boundarySchemaVersion", 0) == 1 && businessUnitPermission(ownerUid, businessId, "logistics", "vehicles.write")
        && validBoundaryUpdate(ownerUid, businessId, "logisticsVehicles", recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/logisticsRoutes/{recordId} {
      allow read: if sparkLegacyReadable(ownerUid) && businessUnitPermission(ownerUid, businessId, "logistics", "routes.read")
        || resource.data.sellerId == request.auth.uid
        || resource.data.collectorId == request.auth.uid
        || resource.data.helperId == request.auth.uid;
      allow create: if request.resource.data.get("boundarySchemaVersion", 0) == 1 && businessUnitPermission(ownerUid, businessId, "logistics", "routes.write")
        && validBoundaryCreate(ownerUid, businessId, "logisticsRoutes", recordId);
      allow update: if validBoundaryUpdate(ownerUid, businessId, "logisticsRoutes", recordId)
        && (
          businessUnitPermission(ownerUid, businessId, "logistics", "routes.write")
          || (businessUnitPermission(ownerUid, businessId, "logistics", "routes.assign")
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "vehicleId", "sellerId", "sellerName", "helperId", "helperName", "collectorId", "collectorName",
              "status", "auditTrail", "recordVersion", "updatedBy", "updatedAt"
            ]))
        );
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/logisticsLoadSheets/{recordId} {
      allow read: if sparkLegacyReadable(ownerUid) && businessUnitPermission(ownerUid, businessId, "logistics", "loadSheets.read")
        || logisticsAssignedTo(ownerUid, businessId, resource.data.routeId, "sellerId")
        || logisticsAssignedTo(ownerUid, businessId, resource.data.routeId, "helperId");
      allow create: if request.resource.data.get("boundarySchemaVersion", 0) == 1 && businessUnitPermission(ownerUid, businessId, "logistics", "loadSheets.write")
        && validBoundaryCreate(ownerUid, businessId, "logisticsLoadSheets", recordId);
      allow update: if sparkLegacyWritable(ownerUid) && request.resource.data.get("boundarySchemaVersion", 0) == 1 && businessUnitPermission(ownerUid, businessId, "logistics", "loadSheets.write")
        && validBoundaryUpdate(ownerUid, businessId, "logisticsLoadSheets", recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/logisticsRouteSales/{recordId} {
      allow read: if sparkLegacyReadable(ownerUid) && businessUnitPermission(ownerUid, businessId, "logistics", "routeSales.read")
        || logisticsAssignedTo(ownerUid, businessId, resource.data.routeId, "sellerId")
        || logisticsAssignedTo(ownerUid, businessId, resource.data.routeId, "collectorId");
      allow create: if request.resource.data.get("boundarySchemaVersion", 0) == 1 && businessUnitPermission(ownerUid, businessId, "logistics", "routeSales.create")
        && logisticsAssignedTo(ownerUid, businessId, request.resource.data.routeId, "sellerId")
        && (request.resource.data.discount == 0 || businessUnitPermission(ownerUid, businessId, "logistics", "routeSales.discount"))
        && validBoundaryCreate(ownerUid, businessId, "logisticsRouteSales", recordId)
        && request.resource.data.actorUid == request.auth.uid;
      // Cancellation is the only post-create mutation, and only for
      // whoever holds routeSales.cancel (never granted by default to any
      // preset -- see WORKER_ROLE_PRESETS/ROLE_PERMISSIONS comments).
      allow update: if sparkLegacyWritable(ownerUid) && request.resource.data.get("boundarySchemaVersion", 0) == 1 && businessUnitPermission(ownerUid, businessId, "logistics", "routeSales.cancel")
        && resource.data.status != "cancelled"
        && request.resource.data.status == "cancelled"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "auditTrail", "recordVersion", "updatedBy", "updatedAt"
        ])
        && validBoundaryUpdate(ownerUid, businessId, "logisticsRouteSales", recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/logisticsCollections/{recordId} {
      allow read: if sparkLegacyReadable(ownerUid) && businessUnitPermission(ownerUid, businessId, "logistics", "collections.read")
        || logisticsAssignedTo(ownerUid, businessId, resource.data.routeId, "collectorId");
      // Collections are append-only (matches the domain's idempotency-key
      // contract in recordCollection -- a real duplicate submit is a
      // no-op resolved client-side against the SAME key, never a second
      // write) -- no update/delete path at all.
      allow create: if request.resource.data.get("boundarySchemaVersion", 0) == 1 && businessUnitPermission(ownerUid, businessId, "logistics", "collections.write")
        && logisticsAssignedTo(ownerUid, businessId, request.resource.data.routeId, "collectorId")
        && validBoundaryCreate(ownerUid, businessId, "logisticsCollections", recordId)
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/logisticsReturns/{recordId} {
      allow read: if sparkLegacyReadable(ownerUid) && businessUnitPermission(ownerUid, businessId, "logistics", "returns.read")
        || logisticsAssignedTo(ownerUid, businessId, resource.data.routeId, "sellerId")
        || logisticsAssignedTo(ownerUid, businessId, resource.data.routeId, "helperId");
      // "delivery" scope: the assigned SELLER or the assigned HELPER
      // (repartidor) may record a return on their own route -- the exact
      // real backend enforcement for the repartidor semantics the client
      // domain layer also implements (assertRouteAccess(route, actor,
      // 'delivery')).
      allow create: if request.resource.data.get("boundarySchemaVersion", 0) == 1 && businessUnitPermission(ownerUid, businessId, "logistics", "returns.write")
        && (logisticsAssignedTo(ownerUid, businessId, request.resource.data.routeId, "sellerId")
          || logisticsAssignedTo(ownerUid, businessId, request.resource.data.routeId, "helperId"))
        && validBoundaryCreate(ownerUid, businessId, "logisticsReturns", recordId)
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/logisticsSettlements/{recordId} {
      allow read: if sparkLegacyReadable(ownerUid) && businessUnitPermission(ownerUid, businessId, "logistics", "settlements.read")
        || logisticsAssignedTo(ownerUid, businessId, resource.data.routeId, "sellerId")
        || logisticsAssignedTo(ownerUid, businessId, resource.data.routeId, "collectorId");
      allow create: if request.resource.data.get("boundarySchemaVersion", 0) == 1 && businessUnitPermission(ownerUid, businessId, "logistics", "settlements.write")
        && validBoundaryCreate(ownerUid, businessId, "logisticsSettlements", recordId);
      allow update: if validBoundaryUpdate(ownerUid, businessId, "logisticsSettlements", recordId)
        && (
          // Reopening an approved/closed settlement is Owner-only,
          // unconditionally -- NOT gated by businessUnitPermission at all,
          // since 'settlements.reopen' is never a real key in any
          // member's permissions map to begin with (see
          // worker-data-boundary.js). This is the belt-and-suspenders
          // rules-layer twin of p2-logistics-domain.js's hard
          // isRoutePrivileged(actor) check in reopenSettlement().
          (resource.data.status in ["approved", "closed"]
            && request.resource.data.status == "reopened"
            && businessUnitOwner(ownerUid, businessId))
          || (request.resource.data.status != "reopened"
            && businessUnitPermission(ownerUid, businessId, "logistics", "settlements.approve"))
        );
      allow delete: if false;
    }

    match /activationRequests/{requestId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          "requestId", "uid", "businessId", "tenantKey", "email", "businessName", "plan",
          "period", "price", "currency", "requestCode", "status", "notes", "createdAt", "appVersion"
        ])
        && request.resource.data.keys().hasOnly([
          "requestId", "uid", "businessId", "tenantKey", "email", "businessName", "plan",
          "period", "price", "currency", "requestCode", "status", "notes", "createdAt", "appVersion"
        ])
        && request.resource.data.requestId == requestId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.businessId == request.auth.uid
        && request.resource.data.tenantKey == "owner:" + request.auth.uid + ":business:" + request.auth.uid
        && (request.resource.data.plan == "base" || request.resource.data.plan == "pro"
          || request.resource.data.plan == "business" || request.resource.data.plan == "enterprise")
        && (request.resource.data.period == "month" || request.resource.data.period == "quarter"
          || request.resource.data.period == "semester" || request.resource.data.period == "year"
          || request.resource.data.period == "custom"
          || (request.resource.data.plan == "base" && request.resource.data.period == "lifetime"))
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.status == "pending"
        && request.resource.data.currency == "USD"
        && (request.resource.data.appVersion == "16.0.0" || request.resource.data.appVersion == "16.2.0")
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /legalAcceptances/{acceptanceId} {
      // r37: CEO Admin must be able to see a customer's real legal status
      // (vigente/pendiente/grace/requiere aceptación) without ever
      // hand-editing Firestore -- isPlatformAdmin() added for that read.
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isPlatformAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          "acceptanceId", "uid", "businessId", "tenantKey", "termsVersion", "privacyVersion",
          "locale", "source", "acceptedAt", "appVersion"
        ])
        && request.resource.data.keys().hasOnly([
          "acceptanceId", "uid", "businessId", "tenantKey", "termsVersion", "privacyVersion",
          "locale", "source", "acceptedAt", "appVersion"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.businessId == request.auth.uid
        && request.resource.data.tenantKey == "owner:" + request.auth.uid + ":business:" + request.auth.uid
        && request.resource.data.acceptanceId == acceptanceId
        && request.resource.data.termsVersion is string
        && request.resource.data.privacyVersion is string
        && (request.resource.data.appVersion == "16.0.0" || request.resource.data.appVersion == "16.2.0")
        && request.resource.data.acceptedAt == request.time;
      allow update, delete: if false;
    }

    // r37 (legacy consent grace): tracks WHEN the "Términos actualizados"
    // banner was first presented to an already-onboarded (legacy) account,
    // separately from legalAcceptances (which only records an actual
    // acceptance). This is mutable bookkeeping -- re-presenting the banner
    // updates lastShownAt but must never move termsPresentedAt backward
    // once set, since that timestamp is what starts the 7-day grace clock.
    // CEO Admin reads this (isPlatformAdmin()) to compute a customer's
    // real legal status (vigente/grace/requiere aceptación) without ever
    // needing to hand-edit Firestore.
    match /legalGraceStatus/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isPlatformAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["uid", "termsPresentedAt", "presentedTermsVersion", "presentedPrivacyVersion", "lastShownAt", "updatedAt"])
        && request.resource.data.uid == uid
        && request.resource.data.termsPresentedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["uid", "termsPresentedAt", "presentedTermsVersion", "presentedPrivacyVersion", "lastShownAt", "updatedAt"])
        && request.resource.data.uid == uid
        // termsPresentedAt is write-once: only the very first presentation
        // may set it (via create); every subsequent update must carry it
        // through unchanged so the 7-day grace window can never be reset.
        && request.resource.data.termsPresentedAt == resource.data.termsPresentedAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // r37 (#93): a lightweight, best-effort health beacon the customer's OWN
    // device writes about itself -- diagnostic-only, never gates the
    // customer's own app, lets CEO Admin see real device health (version,
    // sync status, hydration, pending ops, last runtime error) without ever
    // hand-editing Firestore. Field-allowlisted and size-bounded so this can
    // never become an arbitrary-data write path.
    match /customerHealth/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isPlatformAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          "appVersion", "buildSha", "assetVersion", "isOnline", "tenantDataHydrated",
          "pendingOperations", "syncStatus", "syncReason", "localHash", "remoteHash",
          "lastRuntimeError", "route", "updatedAt"
        ])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // r37 (worker invite flow, Section 11-16): the invite-acceptance
    // transaction already grants a technically-active member record (it
    // must -- server-side seat/security enforcement lives there and is
    // unrelated to this). This collection is a SEPARATE, additive human
    // workflow layer on top: the worker's own client withholds the
    // restricted UI (shows "esperando aprobación" instead) until the
    // OWNER explicitly approves, giving the owner a real chance to review
    // the worker's completed profile before they start operating --
    // without touching the already-audited acceptance transaction/rules.
    match /workerAccessRequests/{requestId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || resource.data.ownerId == request.auth.uid || isPlatformAdmin());
      allow create: if signedIn() && request.auth.uid == request.resource.data.uid
        && requestId == request.resource.data.ownerId + '_' + request.resource.data.uid
        && request.resource.data.keys().hasOnly(["requestId", "ownerId", "uid", "email", "name", "phone", "businessUnitId", "status", "requestedAt", "decidedAt", "decidedBy"])
        && request.resource.data.requestId == requestId
        && request.resource.data.status == "pending"
        && request.resource.data.requestedAt == request.time
        && request.resource.data.decidedAt == null
        && request.resource.data.decidedBy == "";
      allow update: if signedIn() && request.auth.uid == resource.data.ownerId
        && request.resource.data.keys().hasOnly(["requestId", "ownerId", "uid", "email", "name", "phone", "businessUnitId", "status", "requestedAt", "decidedAt", "decidedBy"])
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.requestedAt == resource.data.requestedAt
        && resource.data.status == "pending"
        && (request.resource.data.status == "approved" || request.resource.data.status == "rejected")
        && request.resource.data.decidedAt == request.time
        && request.resource.data.decidedBy == request.auth.uid;
      allow delete: if false;
    }

    // ownerId lets a modular Workers session (where businessId is the
    // business UNIT id, e.g. "biz-p31", not the owner's uid) report
    // telemetry too: tenantKey must be "owner:{ownerId}:business:{businessId}"
    // and the requester must be that tenant's owner or an active unit
    // member. Legacy/owner sessions keep working unchanged: ownerId simply
    // equals businessId there, same as tenantKey's existing self-referential
    // shape.
    function validTelemetryTenant(data) {
      return data.businessId != "demo-click360"
        && data.tenantKey == "owner:" + data.ownerId + ":business:" + data.businessId
        && (
          (data.ownerId == data.businessId && (data.businessId == request.auth.uid || hasActiveMembership(data.businessId)))
          || (data.ownerId != data.businessId && (businessUnitOwner(data.ownerId, data.businessId) || activeBusinessUnitMember(data.ownerId, data.businessId)))
        );
    }

    // Phase 3.2 diagnostic events fire exactly when membership/permission
    // checks fail or a tenant hasn't fully activated -- validTelemetryTenant
    // (which requires proving active membership) would reject the very
    // report of that failure. These event types only require the reporter
    // to be signed in; they carry no write access to tenant data, so a
    // self-reported businessId/tenantKey here is a diagnostics-only signal,
    // not a trust boundary.
    function isTelemetryDiagnosticEvent(eventType) {
      return eventType == "worker_invite_failed" || eventType == "worker_login_failed"
        || eventType == "worker_permission_denied" || eventType == "worker_stock_error"
        || eventType == "worker_cross_tenant_denied" || eventType == "worker_seat_exhausted";
    }

    match /telemetryEvents/{eventId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          "eventId", "eventType", "uidHash", "ownerId", "businessId", "tenantKey", "appVersion",
          "requestId", "mode", "errorCode", "deviceIdHash", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "eventId", "eventType", "uidHash", "ownerId", "businessId", "tenantKey", "appVersion",
          "requestId", "mode", "errorCode", "deviceIdHash", "createdAt"
        ])
        && request.resource.data.eventId == eventId
        && request.resource.data.ownerId is string
        && (isTelemetryDiagnosticEvent(request.resource.data.eventType) || validTelemetryTenant(request.resource.data))
        && (request.resource.data.eventType == "login" || request.resource.data.eventType == "bootstrap"
          || request.resource.data.eventType == "cache_failure" || request.resource.data.eventType == "online_only"
          || request.resource.data.eventType == "sync" || request.resource.data.eventType == "plan_request"
          || request.resource.data.eventType == "invitation" || request.resource.data.eventType == "cash_open"
          || request.resource.data.eventType == "cash_close" || request.resource.data.eventType == "template_save_failure"
          || isTelemetryDiagnosticEvent(request.resource.data.eventType)
          || request.resource.data.eventType == "seat_request")
        && request.resource.data.uidHash is string
        && request.resource.data.uidHash.size() == 16
        && request.resource.data.deviceIdHash is string
        && request.resource.data.deviceIdHash.size() == 16
        && request.resource.data.requestId is string
        && request.resource.data.requestId.size() <= 64
        && request.resource.data.mode is string
        && request.resource.data.mode.size() <= 40
        && request.resource.data.errorCode is string
        && request.resource.data.errorCode.size() <= 80
        && (request.resource.data.appVersion == "16.0.0" || request.resource.data.appVersion == "16.2.0")
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /businesses/{businessId}/auditEvents/{eventId} {
      allow read: if businessId != "demo-click360"
        && ownerReadUser()
        && request.auth.uid == businessId;
      allow create: if businessId != "demo-click360"
        && signedIn()
        && (request.auth.uid == businessId || hasActiveMembership(businessId))
        && request.resource.data.keys().hasAll([
          "eventId", "businessId", "tenantKey", "actorUid", "actorRole", "actorName",
          "action", "entityType", "entityId", "correlationId", "amount", "status",
          "before", "after", "appVersion", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "eventId", "businessId", "tenantKey", "actorUid", "actorRole", "actorName",
          "action", "entityType", "entityId", "correlationId", "amount", "status",
          "before", "after", "appVersion", "createdAt"
        ])
        && request.resource.data.eventId == eventId
        && request.resource.data.businessId == businessId
        && request.resource.data.tenantKey == "owner:" + businessId + ":business:" + businessId
        && request.resource.data.actorUid == request.auth.uid
        && (request.resource.data.actorRole == "owner" || request.resource.data.actorRole == "worker"
          || request.resource.data.actorRole == "cashier" || request.resource.data.actorRole == "inventory")
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() <= 120
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 80
        && request.resource.data.entityType is string
        && request.resource.data.entityType.size() <= 40
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() <= 100
        && request.resource.data.correlationId is string
        && request.resource.data.correlationId.size() > 0
        && request.resource.data.correlationId.size() <= 100
        && request.resource.data.amount is number
        && request.resource.data.status is string
        && request.resource.data.status.size() <= 40
        && request.resource.data.before is map
        && request.resource.data.before.keys().hasOnly(["status", "amount", "stock", "role"])
        && request.resource.data.after is map
        && request.resource.data.after.keys().hasOnly(["status", "amount", "stock", "role"])
        && (request.resource.data.appVersion == "16.0.0" || request.resource.data.appVersion == "16.2.0")
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Administrative operations mostly run through IAM-protected Admin SDK
    // tooling (which bypasses rules entirely) -- these two collections stay
    // hard-blocked for every ordinary client. The ONE exception is the CEO
    // Admin Web panel (r36): the platform admin can create (never modify or
    // delete) a backup/audit entry, and read the audit trail back, exactly
    // mirroring the backup-before-write / audit-after-write pattern every
    // CLI admin script already follows.
    match /adminBackups/{backupId} {
      allow read: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && request.resource.data.actorEmail is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /adminAuditLogs/{eventId} {
      allow read: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && request.resource.data.actorEmail is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // The public client may only read/write the tenant state document. Legacy
    // backups are created by the administrative migrator with Admin SDK.
    match /businesses/{businessId}/state/{stateId} {
      allow read: if stateId == "main" && tenantReadable(businessId);
      allow read: if stateId == "main" && isPlatformAdmin();
      allow create: if stateId == "main" && request.auth.uid == businessId && ownerUser() && writeMatchesTenant(businessId)
        && sparkLegacyWritable(businessId);
      allow update: if stateId == "main"
        && ownerUser()
        && request.auth.uid == businessId
        && writeMatchesTenant(businessId)
        && sparkLegacyWritable(businessId);
      allow delete: if false;
    }

    match /storageRollout/{policyId} {
      allow read: if policyId == "sparkV1" && signedIn();
      allow create, update: if policyId == "sparkV1" && isPlatformAdmin();
      allow delete: if false;
    }

    match /businesses/{ownerUid}/metadata/{metadataId} {
      allow read: if metadataId == "storage" && (sparkOwnerRead(ownerUid) || isPlatformAdmin());
      allow create: if metadataId == "storage" && sparkOwner(ownerUid)
        && sparkRolloutAllowed(ownerUid) && sparkValidControl(ownerUid)
        && request.resource.data.phase == "MIGRATION_PREPARING"
        && request.resource.data.recordVersion == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.remoteRevision
          == get(/databases/$(database)/documents/businesses/$(ownerUid)/state/main).data.revision;
      allow update: if metadataId == "storage" && sparkOwner(ownerUid)
        && sparkValidControl(ownerUid)
        && request.resource.data.recordVersion == resource.data.recordVersion + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.sourceHash == resource.data.sourceHash
        && request.resource.data.remoteHash == resource.data.remoteHash
        && request.resource.data.remoteRevision == resource.data.remoteRevision
        && request.resource.data.deviceRevision == resource.data.deviceRevision
        && request.resource.data.sourceDeviceId == resource.data.sourceDeviceId
        && request.resource.data.businessIds == resource.data.businessIds
        && request.resource.data.recordCount == resource.data.recordCount
        && request.resource.data.payloadBytes == resource.data.payloadBytes
        && request.resource.data.buildSha == resource.data.buildSha
        && sparkPhaseStep(resource.data.phase, request.resource.data.phase);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/legacyConfig/{recordId} {
      allow read: if sparkOwnerRead(ownerUid) || isPlatformAdmin();
      allow create: if sparkOwner(ownerUid)
        && get(sparkControlPath(ownerUid)).data.phase == "SHADOW_WRITING"
        && sparkValidShadow(ownerUid, null, "configEntries", recordId);
      allow update, delete: if false;
    }

    // Shadow records remain immutable until the verified control reaches
    // MODULAR. Operational writes then require an atomic, new ledger entry.
    match /businesses/{ownerUid}/businessUnits/{businessId}/storage/v2/{moduleName}/{recordId} {
      allow read: if (sparkShadowModule(moduleName) || moduleName in ["metadata", "operationLedger"])
        && sparkModuleReadable(ownerUid, businessId, moduleName, recordId);
      allow create: if request.resource.data.keys().hasAll(["sourceHash", "sourcePath"])
        && sparkShadowModule(moduleName) && sparkShadowOwner(ownerUid, businessId)
        && sparkValidShadow(ownerUid, businessId, moduleName, recordId);
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/storage/v2/customers/{recordId} {
      allow create: if request.resource.data.get("module", "") == "customers" && signedIn()
        && sparkCustomerMutation(ownerUid, businessId, recordId, true)
        && sparkBoundOperation(ownerUid, businessId)
        && sparkOperationalCreate(ownerUid, businessId, "customers", recordId);
      allow update: if request.resource.data.get("module", "") == "customers" && signedIn()
        && request.resource.data.lastOperationId != resource.data.get("lastOperationId", "")
        && sparkCustomerMutation(ownerUid, businessId, recordId, false)
        && sparkBoundOperation(ownerUid, businessId)
        && sparkOperationalUpdate(ownerUid, businessId, "customers", recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/storage/v2/products/{recordId} {
      allow create: if request.resource.data.get("module", "") == "products" && signedIn()
        && sparkProductMutation(ownerUid, businessId, recordId, true)
        && sparkBoundOperation(ownerUid, businessId)
        && sparkOperationalCreate(ownerUid, businessId, "products", recordId);
      allow update: if request.resource.data.get("module", "") == "products" && signedIn()
        && request.resource.data.lastOperationId != resource.data.get("lastOperationId", "")
        && sparkProductMutation(ownerUid, businessId, recordId, false)
        && sparkBoundOperation(ownerUid, businessId)
        && sparkOperationalUpdate(ownerUid, businessId, "products", recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/storage/v2/sales/{recordId} {
      allow create: if request.resource.data.get("module", "") == "sales" && signedIn()
        && sparkSaleMutation(ownerUid, businessId, recordId)
        && sparkBoundOperation(ownerUid, businessId)
        && sparkOperationalCreate(ownerUid, businessId, "sales", recordId);
      // Only existing records can receive a payment. A denied CREATE must
      // not enter the UPDATE proof with a missing resource and traverse its
      // cross-document financial checks during verbose deny evaluation.
      // Cheap reject only, NOT authorization: the immutable path/identity
      // tuple is still mandatory in sparkOperationalUpdate below.
      allow update: if request.resource.data.module == "sales" && signedIn() && resource.data is map
        && sparkBoundOperation(ownerUid, businessId)
        && sparkPaymentSaleMutation(ownerUid, businessId, recordId)
        && sparkOperationalUpdate(ownerUid, businessId, "sales", recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/storage/v2/movements/{recordId} {
      allow create: if request.resource.data.get("module", "") == "movements" && signedIn()
        && sparkBoundOperation(ownerUid, businessId)
        && sparkOperationalCreate(ownerUid, businessId, "movements", recordId)
        && sparkMovementMutation(ownerUid, businessId, recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/storage/v2/layaways/{recordId} {
      allow create: if request.resource.data.get("module", "") == "layaways" && signedIn()
        && sparkBoundOperation(ownerUid, businessId)
        && sparkOperationalCreate(ownerUid, businessId, "layaways", recordId)
        && sparkLayawayMutation(ownerUid, businessId, recordId);
      allow update: if request.resource.data.module == "layaways" && signedIn() && resource.data is map
        && sparkBoundOperation(ownerUid, businessId)
        && sparkPaymentLayawayMutation(ownerUid, businessId, recordId)
        && sparkOperationalUpdate(ownerUid, businessId, "layaways", recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/storage/v2/cashSessions/{recordId} {
      allow create: if request.resource.data.get("module", "") == "cashSessions" && signedIn()
        && sparkCashMutation(ownerUid, businessId, recordId, true)
        && sparkBoundOperation(ownerUid, businessId)
        && sparkOperationalCreate(ownerUid, businessId, "cashSessions", recordId);
      allow update: if request.resource.data.get("module", "") == "cashSessions" && signedIn()
        && request.resource.data.lastOperationId != resource.data.get("lastOperationId", "")
        && sparkCashMutation(ownerUid, businessId, recordId, false)
        && sparkBoundOperation(ownerUid, businessId)
        && sparkOperationalUpdate(ownerUid, businessId, "cashSessions", recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/storage/v2/dailyReports/{recordId} {
      allow create: if request.resource.data.get("module", "") == "dailyReports" && signedIn()
        && sparkReportMutation(ownerUid, businessId, recordId, true)
        && sparkBoundOperation(ownerUid, businessId)
        && sparkOperationalCreate(ownerUid, businessId, "dailyReports", recordId);
      allow update: if request.resource.data.get("module", "") == "dailyReports" && signedIn()
        && request.resource.data.lastOperationId != resource.data.get("lastOperationId", "")
        && sparkReportMutation(ownerUid, businessId, recordId, false)
        && sparkBoundOperation(ownerUid, businessId)
        && sparkOperationalUpdate(ownerUid, businessId, "dailyReports", recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/storage/v2/metadata/{recordId} {
      allow update: if request.resource.data.get("module", "") == "metadata" && signedIn()
        && request.resource.data.lastOperationId != resource.data.get("lastOperationId", "")
        && sparkBoundOperation(ownerUid, businessId)
        && sparkOperationalUpdate(ownerUid, businessId, "metadata", recordId)
        && sparkRuntimeMutation(ownerUid, businessId, recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/storage/v2/operationLedger/{recordId} {
      allow create: if request.resource.data.get("module", "") == "operationLedger" && signedIn()
        && sparkOperationalCreate(ownerUid, businessId, "operationLedger", recordId)
        && sparkLedgerProof(ownerUid, businessId, recordId);
      allow delete: if false;
    }

    match /businesses/{ownerUid}/businessUnits/{businessId}/storage/v2/auditEvents/{recordId} {
      allow create: if request.resource.data.get("module", "") == "auditEvents" && signedIn()
        && sparkOperationalCreate(ownerUid, businessId, "auditEvents", recordId)
        && sparkDerivedAudit(ownerUid, businessId, recordId);
      allow delete: if false;
    }

    match /businesses/{businessId}/legacyBackups/{backupId} {
      allow read, write: if false;
    }
  }
}
